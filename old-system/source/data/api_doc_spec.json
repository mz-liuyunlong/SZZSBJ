{
  "title": "内部只读 API 接口文档（internal-readonly）",
  "updated_at": "2026-07-27",
  "note": "生产验证版。仅 超管 与 赖菊娜/刘云龙/翁骏 可访问。以代码真实逻辑为准。",
  "common": {
    "base": "/api/internal-readonly",
    "public_base": "https://giginana.com/api/internal-readonly（亦见 gpt-api.giginana.com；经海外中转反代到 42.193.254.170:3001）",
    "method": "仅 GET；非 GET 或路径含 sync/import/upload/update/delete → 403；PUT/PATCH/DELETE 一律拦截",
    "auth": "Authorization: Bearer <INTERNAL_READONLY_API_TOKEN>；缺失/错误 → 401",
    "pagination": "page（默认 1，最小 1）、page_size（默认 50，上限 500，超限截断，最小 1）",
    "response_shell": "{ \"role\":\"readonly_admin\", \"total\":N, \"page\":P, \"page_size\":S, \"rows\":[...] }",
    "empty": "HTTP 200，rows:[]，total:0",
    "errors": "400 参数/日期非法 · 401 鉴权 · 403 非GET/写类 · 500 {\"error\":\"Query failed\"}（不外泄 SQL/表/路径/token）",
    "and_or": "多条件之间 AND",
    "unknown_params": "未识别参数静默忽略",
    "sort": "仅 /sales-detail/list 支持 sort_by/sort_dir（白名单）；其余接口排序固定",
    "range": "范围查询仅 /ads/keyword-daily（日期区间）与 /sales-detail/list（多种区间）支持",
    "redaction": "返回自动脱敏字段名含 password/token/secret/authorization/cookie/file_path/server_path/env 及值中的 Bearer xxx",
    "common_filters": "addCommonFilters：date（该接口有日期列时生效，精确）、store/store_name（→store_name 精确）、store_id、item_id、msku（均精确）"
  },
