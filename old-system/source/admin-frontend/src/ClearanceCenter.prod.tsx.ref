);

// ── 2026-07-23 批3c 批量导入：CSV 解析（支持引号转义）+ 模板下载 ──
function parseCsv(text: string): string[][] {
  const rows: string[][] = [];
  let cur = "", row: string[] = [], inQ = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i];
    if (inQ) {
      if (ch === '"') {
        if (text[i + 1] === '"') { cur += '"'; i++; }
        else inQ = false;
      } else cur += ch;
    } else if (ch === '"') inQ = true;
    else if (ch === ",") { row.push(cur); cur = ""; }
    else if (ch === "\n" || ch === "\r") {
      if (ch === "\r" && text[i + 1] === "\n") i++;
      row.push(cur); cur = "";
      if (row.some((c) => c.trim() !== "")) rows.push(row);
      row = [];
    } else cur += ch;
  }
  row.push(cur);
  if (row.some((c) => c.trim() !== "")) rows.push(row);
  return rows;
}
function downloadTemplateCsv(filename: string, headers: string[], example: string[]): void {
  const esc = (v: string) => (/[",\n]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v);
  const csv = "\uFEFF" + [headers.map(esc).join(","), example.map(esc).join(",")].join("\n");
  const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = filename;
  a.click();
  URL.revokeObjectURL(a.href);
}
// 国内 Excel 直接另存 CSV 常为 GBK 编码：先按 UTF-8 解码，出现乱码替换符则回退 GBK
async function readCsvFile(file: File): Promise<string> {
  const buf = await file.arrayBuffer();
  const utf8 = new TextDecoder("utf-8").decode(buf);
  if (!utf8.includes("�")) return utf8.replace(/^\uFEFF/, "");
  try { return new TextDecoder("gbk").decode(buf); } catch { return utf8.replace(/^\uFEFF/, ""); }
}

export default function ClearanceCenter({ onNavigate }: { onNavigate?: (key: string) => void } = {}) {
  const [rows, setRows] = useState<Row[]>([]);
  const [kpi, setKpi] = useState<Kpi | null>(null);
  const [stores, setStores] = useState<string[]>([]);
  const [owners, setOwners] = useState<string[]>([]);
  const [fStore, setFStore] = useState<string[]>([]);
  const [fOwner, setFOwner] = useState<string[]>([]);
  const [fState, setFState] = useState("");
  const [fChannel, setFChannel] = useState<string[]>([]);
  const [availableMonths, setAvailableMonths] = useState<string[]>([]);
  const [syncTime, setSyncTime] = useState("");
  const [colWidths, setColWidths] = useState<Record<string, number>>({});
  const [showKpi, setShowKpi] = useState(true);
  const [page, setPage] = useState(1);
  const [pageSize, setPageSize] = useState(50);
  const [loading, setLoading] = useState(false);
  const [msg, setMsg] = useState("");
  const [showAdd, setShowAdd] = useState(false);
  const [addSku, setAddSku] = useState("");
  const [addOwner, setAddOwner] = useState("");
  const [addChannel, setAddChannel] = useState("亚马逊");
  const [addRef, setAddRef] = useState("");
  const [addStock, setAddStock] = useState("");
  const [addRemark, setAddRemark] = useState("");
  const [lookupInfo, setLookupInfo] = useState("");
  const [operator, setOperator] = useState("");
  const [saving, setSaving] = useState(false);
  // 2026-07-21 需求方：列配置与订单利润完全一致（勾选/拖动排序/置顶/📌固定左冻结/应用重置）
  // 2026-07-23 新增列：清货库存成本 / 本月目标 / 本月已清 / 达成率
  const ALL_COLS = ["SKU", "产品ID", "渠道", "店铺", "负责人", "进入清货", "库存", "在途", "清货库存成本", "7日日销", "本月目标", "本月已清", "达成率", "预计清完", "预计清货结束", "状态", "操作"];
  const MAX_PINNED_COLUMNS = 7;
  const NEW_COLS_20260723 = ["清货库存成本", "本月目标", "本月已清", "达成率"];
  const [selectedCols, setSelectedCols] = useState<string[]>(() => {
    try {
      const saved = JSON.parse(localStorage.getItem("clearance_center_selected_cols") || "[]") as string[];
      const valid = saved.filter((c) => ALL_COLS.includes(c));
      if (!valid.length) return ALL_COLS;
      // 已保存列配置的用户自动补上新增列（一次性；此后可在列配置中自行取消）
      return [...valid, ...NEW_COLS_20260723.filter((c) => !valid.includes(c))];
    } catch { return ALL_COLS; }
  });
  const [pinnedCols, setPinnedCols] = useState<string[]>(() => {
    try {
      return (JSON.parse(localStorage.getItem("clearance_center_pinned_cols") || "[]") as string[]).filter((c) => ALL_COLS.includes(c));
    } catch { return []; }
  });
  const [cfgSelected, setCfgSelected] = useState<string[]>([]);
  const [cfgPins, setCfgPins] = useState<string[]>([]);
  const dragColIdxRef = useRef<number | null>(null);
  const [ownersAll, setOwnersAll] = useState<string[]>([]);
  const COL_W: Record<string, string> = {
    "SKU": "130px", "产品ID": "155px", "渠道": "70px", "店铺": "150px", "负责人": "80px", "进入清货": "100px",
    "库存": "70px", "在途": "60px", "清货库存成本": "120px", "7日日销": "80px",
    "本月目标": "125px", "本月已清": "80px", "达成率": "130px", "预计清完": "90px", "预计清货结束": "140px",
    "状态": "120px", "操作": "180px",
  };
  const [fSku, setFSku] = useState("");
  const [sortCol, setSortCol] = useState("");
  const [sortDir, setSortDir] = useState<1 | -1>(1);
  const [showColCfg, setShowColCfg] = useState(false);
  // 展示顺序=固定列在前（与订单利润一致，固定列左侧冻结）
  const visibleCols = [
    ...selectedCols.filter((c) => pinnedCols.includes(c)),
    ...selectedCols.filter((c) => !pinnedCols.includes(c)),
  ];
  const cfgOrderedSelected = [
    ...cfgSelected.filter((c) => cfgPins.includes(c)),
    ...cfgSelected.filter((c) => !cfgPins.includes(c)),
  ];
  // 固定列 sticky left 偏移（按列宽累加）
  const pinLeft: Record<string, number> = {};
  {
    let acc = 0;
    for (const c of visibleCols) {
      if (!pinnedCols.includes(c)) break;
      pinLeft[c] = acc;
      acc += colWidths[c] ?? parseInt(COL_W[c] ?? "100", 10);
    }
  }
  function openColCfg() {
    setCfgSelected(visibleCols);
    setCfgPins(pinnedCols);
    setShowColCfg(true);
  }
  function applyColCfg() {
    setSelectedCols(cfgOrderedSelected);
    setPinnedCols(cfgPins);
    try {
      localStorage.setItem("clearance_center_selected_cols", JSON.stringify(cfgOrderedSelected));
      localStorage.setItem("clearance_center_pinned_cols", JSON.stringify(cfgPins));
    } catch { /* 忽略 */ }
    setShowColCfg(false);
  }
  function refPrefix(channel: string): string {
    return channel === "亚马逊" ? "ASIN" : channel === "希音" ? "平台SKC" : channel === "TEMU" ? "SPU" : channel === "TikTok" ? "商品ID" : "ItemID";
  }

  // 2026-07-23 数据下载：与运营日志同链路——密码授权(dim_access_password)→biz_event审计→CSV
  const [exporting, setExporting] = useState(false);
  async function handleExport() {
    const password = window.prompt("请输入下载密码：");
    if (!password) return;
    setExporting(true);
    try {
      const filtersDesc = JSON.stringify({ store: fStore, owner: fOwner, state: fState, kw: fSku, channel: fChannel, month: planMonth });
      const vRes = await fetch("/api/help/export-verify", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password: password.trim(), page_key: "clearance_center", filters: filtersDesc }),
      });
      const vData = await vRes.json();
      if (!vRes.ok || !vData.token) { alert(vData.error || "下载密码校验失败"); return; }
      const list = displayRows();
      if (!list.length) { alert("当前筛选无数据可导出"); return; }
      const cols = ["SKU", "MSKU", "产品ID", "渠道", "店铺", "负责人", "进入清货", "库存", "在途",
        "清货库存成本(¥)", "7日日销", "本月目标(件)", "本月已清(件)", "达成率", "预计清完(天)", "预计清货结束", "状态", "备注"];
      const esc = (v: unknown) => {
        const sv = v === null || v === undefined ? "" : String(v);
        return /[",\n]/.test(sv) ? `"${sv.replace(/"/g, '""')}"` : sv;
      };
      const lines = list.map((r) => [
        r.sku, r.mskus, r.platform_ref ? `${refPrefix(r.channel)}:${r.platform_ref}` : "", r.channel,
        r.row_type === "manual" ? "" : r.store_name, r.owner, r.entered_at, r.stock,
        r.row_type === "manual" ? "" : r.inbound,
        r.stock_cost === null ? (r.row_type === "manual" ? "" : "缺成本") : r.stock_cost,
        r.daily7 ?? "", r.month_target ?? "", r.month_cleared ?? "",
        r.month_target && r.month_target > 0 ? `${Math.round((r.month_cleared ?? 0) / r.month_target * 100)}%` : "",
        r.stock === 0 ? "已清完" : r.days_to_clear ?? "", r.expect_end, r.state, r.remark,
      ].map(esc).join(","));
      const csv = "\uFEFF" + [cols.map(esc).join(","), ...lines].join("\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `清货中心_${planMonth || "当月"}_${list.length}行.csv`;
      a.click();
      URL.revokeObjectURL(a.href);
    } catch (e) {
      alert("导出失败: " + String(e));
    } finally {
      setExporting(false);
    }
  }

  // 2026-07-23 批3c 批量导入（其他渠道清货 / 本月清货目标）
  const [showImport, setShowImport] = useState(false);
  const [importType, setImportType] = useState<"other" | "target">("other");
  const [importOwner, setImportOwner] = useState("");

  // 2026-07-24 批量导入升级：模板改 xlsx（后端渲染，负责人/渠道下拉），必选导入负责人
  const ccDownloadTemplateXlsx = async (): Promise<void> => {
    try {
      const payload = importType === "target"
        ? {
            type: "target", owner: importOwner,
            rows: rows.filter((r) => r.owner === importOwner && (r.row_type === "auto" ? !!r.item_id : !!r.platform_ref))
              .map((r) => [r.channel, r.platform_ref, r.store_id, r.row_type === "auto" ? r.store_name : r.channel, r.sku, r.owner,
                r.month_target === null || r.month_target === undefined ? "" : String(r.month_target),
                r.month_cleared === null || r.month_cleared === undefined ? "" : String(r.month_cleared)]),
          }
        : { type: "other", owner: importOwner, owners };
      if (importType === "target" && (payload as { rows?: unknown[] }).rows?.length === 0) {
        setImportResult(["❌ 该负责人当前没有清货产品"]); return;
      }
      const resp = await fetch("/api/clearance-center/template-xlsx", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload),
      });
      if (!resp.ok) {
        const d = await resp.json().catch(() => ({}));
        setImportResult([`❌ 模板生成失败：${String(d.error || `HTTP ${resp.status}`)}`]); return;
      }
      const blob = await resp.blob();
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = importType === "target" ? `清货目标导入模板_${importOwner}.xlsx` : `其他渠道清货导入模板_${importOwner}.xlsx`;
      a.click();
      URL.revokeObjectURL(a.href);
    } catch (err) {
      setImportResult([`❌ 模板生成失败：${String(err)}`]);
    }
  };
  const [importing, setImporting] = useState(false);
  const [importResult, setImportResult] = useState<string[]>([]);
  const importFileRef = useRef<HTMLInputElement | null>(null);
  function downloadImportTemplate() {
    if (!importOwner) { setImportResult(["❌ 请先选择导入负责人"]); return; }
    if (importType === "target") {
      void ccDownloadTemplateXlsx();
    } else {
      void ccDownloadTemplateXlsx();
    }
  }
  async function handleImportFile(file: File) {
    setImporting(true);
    setImportResult([]);
    try {
      if (!importOwner) { setImportResult(["❌ 请先选择导入负责人"]); return; }
    let grid: string[][];
    if (/\.xlsx$/i.test(file.name)) {
      const buf = await file.arrayBuffer();
      const resp0 = await fetch("/api/clearance-center/parse-xlsx", {
        method: "POST", headers: { "Content-Type": "application/octet-stream" }, body: buf,
      });
      const d0 = await resp0.json().catch(() => ({}));
      if (!resp0.ok || d0.error || !Array.isArray(d0.grid)) {
        setImportResult([`❌ Excel 解析失败：${String(d0.error || `HTTP ${resp0.status}`)}`]); return;
      }
      grid = (d0.grid as unknown[][]).map((r) => r.map((c) => String(c ?? "")));
    } else {
      const text = await readCsvFile(file);
      grid = parseCsv(text);
    }
      if (grid.length < 2) { setImportResult(["❌ 文件为空或只有表头"]); return; }
      const head0 = (grid[0][0] ?? "").trim();
      const expect0 = importType === "target" ? "渠道" : "产品SKU";
      if (!head0.startsWith(expect0)) {
        setImportResult([`❌ 模板类型不符：当前导入类型首列应为「${expect0}」，实际为「${head0 || "(空)"}」。请下载对应模板填写。`]);
        return;
      }
      const dataRows = grid.slice(1);
      const body = importType === "target"
        ? { rows: dataRows.map((r) => ({ channel: (r[0] ?? "").trim(), item_id: (r[1] ?? "").trim(), store_id: (r[2] ?? "").trim(), sku: (r[4] ?? "").trim(), owner: (r[5] ?? "").trim(), target_qty: (r[6] ?? "").trim(), cleared_qty: (r[7] ?? "").trim() })), import_owner: importOwner, operator_name: operator.trim() || `bulk:${importOwner}` }
        : { rows: dataRows.map((r) => ({
              sku: (r[0] ?? "").trim(), owner: (r[1] ?? "").trim(), channel: (r[2] ?? "").trim(),
              platform_ref: (r[3] ?? "").trim(), manual_stock: (r[4] ?? "").trim(), remark: (r[5] ?? "").trim(),
            })), import_owner: importOwner, operator_name: operator.trim() || `bulk:${importOwner}` };
      const endpoint = importType === "target" ? "import-monthly-target" : "import-other-channel";
      const res = await fetch(`/api/clearance-center/${endpoint}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      const lines = [`✅ 导入完成：共 ${data.total} 行，成功 ${data.success}，失败 ${data.failed}`];
      for (const e of data.errors ?? []) lines.push(`· ${e}`);
      setImportResult(lines);
      await load();
    } catch (err) {
      setImportResult([`❌ 导入失败：${String(err)}`]);
    } finally {
      setImporting(false);
      if (importFileRef.current) importFileRef.current.value = "";
    }
  }

  // 2026-07-23 本月清货目标：行内录入 → 写月度规划同底座（biz_monthly_plan indicator=清货）
  const [planMonth, setPlanMonth] = useState("");
  const [targetDrafts, setTargetDrafts] = useState<Record<string, string>>({});
  const [clearedDrafts, setClearedDrafts] = useState<Record<string, string>>({});
  const [targetSavingKey, setTargetSavingKey] = useState("");
  // 2026-07-24 产品维度重构：手工渠道行（亚马逊/希音）目标/已清 行内编辑 → /manual-target
  async function saveManualField(row: Row, kind: "target" | "cleared") {
    const raw = ((kind === "target" ? targetDrafts[row.row_key] : clearedDrafts[row.row_key]) ?? "").trim();
    const n = Number(raw);
    if (kind === "target" && (!raw || !Number.isFinite(n) || n < 1)) { setMsg("目标件数必须为 ≥1 的数字"); return; }
    if (kind === "cleared" && (!raw || !Number.isFinite(n) || n < 0)) { setMsg("已清件数必须为 ≥0 的数字"); return; }
    setTargetSavingKey(row.row_key);
    try {
      const res = await fetch("/api/clearance-center/manual-target", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          manual_id: row.manual_id,
          [kind === "target" ? "target_qty" : "cleared_qty"]: n,
          operator_name: operator.trim() || "admin_ui",
        }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      if (kind === "target") setTargetDrafts((prev) => { const next = { ...prev }; delete next[row.row_key]; return next; });
      else setClearedDrafts((prev) => { const next = { ...prev }; delete next[row.row_key]; return next; });
      setMsg(`手工渠道行${kind === "target" ? "本月目标" : "本月已清"}已保存（${data.plan_month}）`);
      await load();
    } catch (err) {
      setMsg(`保存失败：${String(err)}`);
    } finally {
      setTargetSavingKey("");
    }
  }
  async function saveTarget(row: Row) {
    const raw = (targetDrafts[row.row_key] ?? "").trim();
    const n = Number(raw);
    if (!raw || !Number.isFinite(n) || n < 1) { setMsg("目标件数必须为 ≥1 的数字"); return; }
    setTargetSavingKey(row.row_key);
    try {
      const res = await fetch("/api/clearance-center/monthly-target", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ store_id: row.store_id, item_id: row.item_id, target_qty: n, operator_name: operator.trim() || "admin_ui" }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setTargetDrafts((prev) => { const next = { ...prev }; delete next[row.row_key]; return next; });
      setMsg(`本月清货目标已保存（${data.plan_month} · ${data.target}件，已同步月度规划）`);
      await load();
    } catch (err) {
      setMsg(`目标保存失败：${String(err)}`);
    } finally {
      setTargetSavingKey("");
    }
  }

  async function saveExpect(row: Row, value: string) {
    try {
      const res = await fetch("/api/clearance-center/expect-date", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ row_key: row.row_key, expect_end: value, operator_name: operator.trim() || "admin_ui" }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setRows((prev) => prev.map((r) => (r.row_key === row.row_key ? { ...r, expect_end: value } : r)));
    } catch (err) {
      setMsg(`预计清货结束时间保存失败：${String(err)}`);
    }
  }

  // 2026-07-25 清货审批：页面同意/驳回（后端 requirePermission 把关，无权限点了提示403）
  async function ccApprove(row: Row) {
    if (!row.approval_id) return;
    if (!window.confirm(`确认通过清货申请？\n${row.sku} ｜ ${row.store_name} ｜ ItemID ${row.platform_ref}\n通过后该产品进入清货期。`)) return;
    try {
      const res = await fetch("/api/clearance-center/approve", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: row.approval_id }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setMsg(`已通过：${row.sku}（ItemID ${row.platform_ref}）进入清货期`);
      await load();
    } catch (err) { setMsg(`审批失败：${String(err)}`); }
  }
  async function ccReject(row: Row) {
    if (!row.approval_id) return;
    const reason = window.prompt(`驳回清货申请（理由可填可不填）：\n${row.sku} ｜ ItemID ${row.platform_ref}`, "");
    if (reason === null) return;
    try {
      const res = await fetch("/api/clearance-center/reject", {
        method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: row.approval_id, reason }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setMsg(`已驳回：${row.sku}（ItemID ${row.platform_ref}）`);
      await load();
    } catch (err) { setMsg(`驳回失败：${String(err)}`); }
  }

  const SORT_VAL: Record<string, (r: Row) => string | number> = {
    "SKU": (r) => r.sku,
    "产品ID": (r) => r.platform_ref,
    "渠道": (r) => r.channel,
    "店铺": (r) => r.store_name,
    "负责人": (r) => r.owner,
    "进入清货": (r) => r.entered_at,
    "库存": (r) => r.stock,
    "在途": (r) => r.inbound,
    "清货库存成本": (r) => r.stock_cost ?? -1,
    "7日日销": (r) => r.daily7 ?? -1,
    "本月目标": (r) => r.month_target ?? -1,
    "本月已清": (r) => r.month_cleared ?? -1,
    "达成率": (r) => (r.month_target && r.month_target > 0 ? (r.month_cleared ?? 0) / r.month_target : -1),
    "预计清完": (r) => r.days_to_clear ?? (r.stock === 0 ? -1 : 999999),
    "预计清货结束": (r) => r.expect_end || "9999-12-31",
    "状态": (r) => r.state,
  };

  function displayRows(): Row[] {
    let out = rows;
    if (fStore.length) out = out.filter((r) => fStore.includes(r.store_name));
    if (fOwner.length) out = out.filter((r) => fOwner.includes(r.owner));
    if (fState) out = out.filter((r) => r.state === fState);
    if (fChannel.length) out = out.filter((r) => fChannel.includes(r.channel));
    const kw = fSku.trim().toLowerCase();
    if (kw) out = out.filter((r) => r.sku.toLowerCase().includes(kw) || r.mskus.toLowerCase().includes(kw));
    if (sortCol && SORT_VAL[sortCol]) {
      const get = SORT_VAL[sortCol];
      out = [...out].sort((a, b) => {
        const va = get(a); const vb = get(b);
        if (typeof va === "number" && typeof vb === "number") return (va - vb) * sortDir;
        return String(va).localeCompare(String(vb), "zh") * sortDir;
      });
    }
    return out;
  }

  function onSort(col: string) {
    if (!SORT_VAL[col]) return;
    if (sortCol === col) setSortDir((d) => (d === 1 ? -1 : 1));
    else { setSortCol(col); setSortDir(1); }
  }
  function startResize(e: React.MouseEvent, col: string): void {
    e.preventDefault(); e.stopPropagation();
    const startX = e.clientX;
    const startW = colWidths[col] ?? parseInt(COL_W[col] ?? "100", 10);
    const onMove = (ev: MouseEvent): void => { const w = Math.max(60, startW + (ev.clientX - startX)); setColWidths((prev) => ({ ...prev, [col]: w })); };
    const onUp = (): void => { window.removeEventListener("mousemove", onMove); window.removeEventListener("mouseup", onUp); };
    window.addEventListener("mousemove", onMove); window.addEventListener("mouseup", onUp);
  }
  const COL_INFO: Record<string, string> = {
    "进入清货": "产品进入清货期的日期；无审批记录的存量遗留产品统一显示 2026-07-31。",
    "库存": "沃尔玛行=最新快照WFS可售；其他渠道行=人工维护。恒为当前实时值，不随所选月份变化。",
    "在途": "沃尔玛在途库存（最新快照）；其他渠道不接入在途，显示 —。",
    "清货库存成本": "(采购+头程)×当前库存，与产品管理成本配置同源（人民币）。",
    "7日日销": "近7个数据日的日均销量；恒为当前实时值。",
    "本月目标": "所选月份的清货目标（件），与月度规划同底座（indicator=清货）。切月查看对应月。",
    "本月已清": "所选月份销量合计（T-2滞后；移仓/弃置/其他渠道不计入沃尔玛口径）。",
    "达成率": "本月已清 ÷ 本月目标；库存清零显示已清完。",
    "预计清完": "库存 ÷ 7日日销（天）；恒为实时。",
  };

  const load = useCallback(async (m?: string) => {
    setLoading(true);
    setMsg("");
    try {
      const q = m ? `?month=${encodeURIComponent(m)}` : "";
      const res = await fetch(`/api/clearance-center/list${q}`);
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setRows(data.rows ?? []);
      setKpi(data.kpi ?? null);
      setPlanMonth(String(data.plan_month ?? ""));
      setAvailableMonths(data.available_months ?? []);
      setSyncTime(String(data.sync_time ?? ""));
      setStores(data.stores ?? []);
      setOwners(data.owners ?? []);
    } catch (err) {
      setMsg(`加载失败：${String(err)}`);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => { void load(); }, [load]);
  useEffect(() => { setPage(1); }, [fStore, fOwner, fState, fSku, fChannel, pageSize]);

  // 负责人下拉选项（2026-07-21 需求方：选择不填写）
  useEffect(() => {
    void (async () => {
      try {
        const res = await fetch("/api/clearance-center/owners");
        const data = await res.json();
        if (res.ok && !data.error) setOwnersAll(data.owners ?? []);
      } catch { /* 忽略，回退用列表 owners */ }
    })();
  }, []);

  // 2026-07-21：去掉查产品按钮，SKU 失焦自动查并预填负责人
  async function autoLookup() {
    setLookupInfo("");
    if (!addSku.trim()) return;
    try {
      const res = await fetch(`/api/clearance-center/product-lookup?sku=${encodeURIComponent(addSku.trim())}`);
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      const m = (data.matches ?? [])[0];
      if (m) {
        if (m.owner && !addOwner.trim()) setAddOwner(String(m.owner));
        setLookupInfo(`产品库命中：${m.mskus}（负责人 ${m.owner || "无"}）`);
      } else {
        setLookupInfo("产品库未命中该 SKU（仍可添加）");
      }
    } catch (err) {
      setLookupInfo(`查询失败：${String(err)}`);
    }
  }

  async function doAdd() {
    if (!addSku.trim() || !addOwner.trim() || !addRef.trim()) {
      setMsg("SKU、负责人、平台识别号必填");
      return;
    }
    setSaving(true);
    try {
      const res = await fetch("/api/clearance-center/manual-add", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          sku: addSku.trim(), owner: addOwner.trim(), channel: addChannel,
          platform_ref: addRef.trim(), manual_stock: Number(addStock || 0),
          remark: addRemark.trim(), operator_name: operator.trim() || "admin_ui",
        }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setShowAdd(false);
      setAddSku(""); setAddOwner(""); setAddRef(""); setAddStock(""); setAddRemark(""); setLookupInfo("");
      setMsg(data.product_found ? "已添加到其他渠道清货台账" : "已添加（注意：产品库未命中该 SKU）");
      await load();
    } catch (err) {
      setMsg(`添加失败：${String(err)}`);
    } finally {
      setSaving(false);
    }
  }

  async function manualStatus(row: Row, status: "done" | "removed") {
    if (!row.manual_id) return;
    const label = status === "done" ? "标记清货完成" : "移出台账";
    if (!window.confirm(`确认${label}：${row.sku}（${row.channel}）？`)) return;
    try {
      const res = await fetch("/api/clearance-center/manual-update", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: row.manual_id, status, operator_name: operator.trim() || "admin_ui" }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setMsg(`已${label}`);
      await load();
    } catch (err) {
      setMsg(`操作失败：${String(err)}`);
    }
  }

  async function manualEditStock(row: Row) {
    if (!row.manual_id) return;
    const input = window.prompt(`更新「${row.sku}（${row.channel}）」渠道库存数量：`, String(row.stock));
    if (input === null) return;
    const n = Number(input);
    if (!Number.isFinite(n) || n < 0) { setMsg("库存数量必须为非负整数"); return; }
    try {
      const res = await fetch("/api/clearance-center/manual-update", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ id: row.manual_id, manual_stock: n, operator_name: operator.trim() || "admin_ui" }),
      });
      const data = await res.json();
      if (!res.ok || data.error) throw new Error(data.error || `HTTP ${res.status}`);
      setMsg("库存已更新");
      await load();
    } catch (err) {
      setMsg(`更新失败：${String(err)}`);
    }
  }

  // 2026-07-23：新增 本月清货目标达成 / 清货库存成本 两卡（value 支持字符串，sub 为附注行）
  const targetPct = kpi && kpi.month_target_total > 0
    ? Math.round(kpi.month_cleared_on_target / kpi.month_target_total * 100) : null;
  const kpiItems: Array<{ label: string; value: number | string; bg: string; fg: string; sub?: string }> = kpi ? [
    { label: "清货中", value: kpi.clearing, bg: "#dbeafe", fg: "#1d4ed8" },
    { label: "待林翔审批", value: kpi.pending, bg: "#fef3c7", fg: "#92400e" },
    { label: "≤60天可卖（周五卡范围）", value: kpi.friday_due, bg: "#fce7f3", fg: "#9d174d" },
    { label: "清零待归档", value: kpi.cleared, bg: "#dcfce7", fg: "#166534" },
    { label: "其他渠道清货", value: kpi.other_channel, bg: "#f3f4f6", fg: "#4b5563" },
    {
      label: `本月清货目标${targetPct !== null ? `达成 ${targetPct}%` : ""}（${planMonth || "当月"}）`,
      value: `${(kpi.month_cleared_on_target ?? 0).toLocaleString()} / ${(kpi.month_target_total ?? 0).toLocaleString()} 件`,
      bg: "#eef2ff", fg: "#3730a3",
      sub: kpi.no_target_count > 0 ? `${kpi.no_target_count} 个产品未设目标` : "清货池目标已全覆盖",
    },
    {
      label: "清货库存成本（(采购+头程)×库存）",
      value: `¥ ${(kpi.stock_cost_total ?? 0).toLocaleString(undefined, { maximumFractionDigits: 0 })}`,
      bg: "#fee2e2", fg: "#991b1b",
      sub: kpi.cost_missing_count > 0 ? `${kpi.cost_missing_count} 个缺成本未计入` : "成本配置全覆盖",
    },
  ] : [];

  const shownAll = displayRows();
  const totalRows = shownAll.length;
  const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
  const curPage = Math.min(page, totalPages);
  const pagedRows = shownAll.slice((curPage - 1) * pageSize, curPage * pageSize);
  const sumOf = (fn: (r: Row) => number): number => shownAll.reduce((acc, r) => acc + (fn(r) || 0), 0);

  return (
    <div>
      {showKpi && (
      <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))", gap: "10px", marginBottom: "12px" }}>
        {kpiItems.map((k) => (
          <div key={k.label} style={{ background: k.bg, borderRadius: "10px", padding: "10px 12px" }}>
            <div style={{ fontSize: "12px", color: k.fg }}>{k.label}</div>
            <div style={{ fontSize: typeof k.value === "number" ? "22px" : "18px", fontWeight: 700, color: k.fg }}>{k.value}</div>
            {k.sub && <div style={{ fontSize: "11px", color: "#b45309", marginTop: "2px" }}>{k.sub}</div>}
          </div>
        ))}
      </div>
      )}

      <div style={{ ...card, display: "flex", gap: "8px", alignItems: "center", flexWrap: "wrap" }}>
        <LxMultiSelect placeholder="全部店铺" minWidth={150}
          options={stores.map((s) => ({ value: s, label: s }))}
          selected={fStore} onChange={setFStore} />
        <LxMultiSelect placeholder="全部负责人" minWidth={120}
          options={owners.map((o) => ({ value: o, label: o }))}
          selected={fOwner} onChange={setFOwner} />
        <LxMultiSelect placeholder="全部渠道" minWidth={100}
          options={[...new Set(rows.map((r) => r.channel).filter(Boolean))].sort().map((c) => ({ value: c, label: c }))}
          selected={fChannel} onChange={setFChannel} />
        <select style={sel} value={planMonth} onChange={(e) => { setPage(1); void load(e.target.value); }} title="清货按月计算：切换查看该月的目标/已清/达成率；库存等恒为实时">
          {(availableMonths.length ? availableMonths : [planMonth].filter(Boolean)).map((m) => <option key={m} value={m}>{m}</option>)}
        </select>
        <select style={sel} value={fState} onChange={(e) => setFState(e.target.value)}>
          <option value="">状态：全部</option>
          {["清货中", "待审批", "清零待归档", "其他渠道清货"].map((s) => <option key={s} value={s}>{s}</option>)}
        </select>
        <input style={{ ...sel, width: "130px" }} placeholder="SKU/MSKU 搜索" value={fSku} onChange={(e) => setFSku(e.target.value)} />
        <input style={{ ...sel, width: "110px" }} placeholder="操作人(选填)" value={operator} onChange={(e) => setOperator(e.target.value)} />
        {/* 2026-07-23 领星式工具栏（与运营日志同款）；批3c：添加/批量导入按钮前置于统计与图标区 */}
        <span style={{ marginLeft: "auto", display: "flex", alignItems: "center", whiteSpace: "nowrap", flexShrink: 0 }}>
          <button style={primaryBtn} onClick={() => { setShowAdd(true); setMsg(""); }}>+ 添加其他渠道清货</button>
          <button style={{ ...btn, marginLeft: "8px" }} onClick={() => { setShowImport(true); setImportResult([]); setMsg(""); }}>批量导入</button>
          <span style={{ fontSize: "12px", color: "#6b7280", whiteSpace: "nowrap", marginLeft: "12px" }}>
            共 <b style={{ color: "#374151" }}>{totalRows}</b> 行 · 第 <b style={{ color: "#374151" }}>{curPage}</b>/{totalPages} 页{syncTime ? ` · 同步 ${syncTime}` : ""}{loading ? " · 加载中…" : ""}
          </span>
          <span style={{ display: "flex", alignItems: "center", gap: "2px", marginLeft: "10px", flexShrink: 0 }}>
            <button style={ICON_BTN} title="隐藏 / 显示 顶部KPI"
              onClick={() => setShowKpi((v) => !v)}><span style={{ fontSize: "15px", lineHeight: 1 }}>▤</span></button>
            <button style={{ ...btn, padding: "4px 10px", fontSize: "12px", marginRight: "4px" }} title="拖列头右缘调列宽 · 此处一键复位"
              onClick={() => setColWidths({})}>列宽重置</button>
            <button style={ICON_BTN} title="刷新" disabled={loading}
              onClick={() => void load(planMonth)}><IconRefresh /></button>
            <button style={ICON_BTN} title="帮助：本页规则与数据口径"
              onClick={() => { if (onNavigate) { onNavigate("help"); window.location.hash = "#/help?page=clearance_center"; } else { window.open("#/help?page=clearance_center", "_blank"); } }}><IconHelp /></button>
            <span style={{ width: "1px", height: "16px", background: "#e5e7eb", margin: "0 5px" }} />
            <button style={{ ...ICON_BTN, opacity: exporting ? 0.4 : 1 }} disabled={exporting} title="下载（需密码）"
              onClick={() => void handleExport()}><IconDownload /></button>
            <button style={ICON_BTN} title="列配置"
              onClick={openColCfg}><IconColumns /></button>
          </span>
        </span>
      </div>

      {/* 2026-07-23 批3c 批量导入弹窗（交互对齐领星"导入费用"弹窗） */}
      {showImport && (
        <div style={{ position: "fixed", inset: 0, background: "rgba(15,23,42,0.4)", zIndex: 1000, display: "flex", alignItems: "center", justifyContent: "center" }}
          onClick={() => !importing && setShowImport(false)}>
          <div style={{ background: "#fff", borderRadius: "12px", width: "640px", maxHeight: "80vh", overflowY: "auto", boxShadow: "0 8px 32px rgba(0,0,0,0.18)" }}
            onClick={(e) => e.stopPropagation()}>
            <div style={{ padding: "14px 18px", borderBottom: "1px solid #e5e7eb", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <span style={{ fontSize: "15px", fontWeight: 700, color: "#111827" }}>批量导入</span>
              <button onClick={() => !importing && setShowImport(false)}
                style={{ border: "none", background: "none", fontSize: "18px", cursor: "pointer", color: "#9ca3af" }}>×</button>
            </div>
            <div style={{ padding: "16px 18px" }}>
              <div style={{ display: "flex", alignItems: "center", gap: "10px", marginBottom: "14px", fontSize: "13px", flexWrap: "wrap" }}>
          <span style={{ color: "#374151", fontWeight: 600 }}>导入负责人 <span style={{ color: "#dc2626" }}>*</span>：</span>
          <select value={importOwner} onChange={(e) => { setImportOwner(e.target.value); setImportResult([]); }} style={sel} disabled={importing}>
            <option value="">请选择负责人（必选，单人）</option>
            {owners.map((o) => <option key={o} value={o}>{o}</option>)}
          </select>
          {!importOwner && <span style={{ fontSize: "12px", color: "#b45309", background: "#fffbeb", border: "1px solid #fde68a", borderRadius: "6px", padding: "3px 8px" }}>⚠️ 未选择负责人，无法下载模板或导入</span>}
        </div>
        <div style={{ display: "flex", alignItems: "center", gap: "18px", marginBottom: "16px", fontSize: "13px" }}>
                <span style={{ color: "#374151" }}>导入类型：</span>
                <label style={{ display: "flex", alignItems: "center", gap: "5px", cursor: "pointer" }}>
                  <input type="radio" name="cc_import_type" checked={importType === "other"}
                    onChange={() => { setImportType("other"); setImportResult([]); }} /> 其他渠道清货
                </label>
                <label style={{ display: "flex", alignItems: "center", gap: "5px", cursor: "pointer" }}>
                  <input type="radio" name="cc_import_type" checked={importType === "target"}
                    onChange={() => { setImportType("target"); setImportResult([]); }} /> 本月清货目标
                </label>
              </div>
              <div style={{ display: "flex", alignItems: "center", gap: "14px", marginBottom: "14px" }}>
                <button style={{ ...primaryBtn, opacity: importing ? 0.5 : 1 }} disabled={importing}
                  onClick={() => importFileRef.current?.click()}>{importing ? "导入中…" : "导入文件"}</button>
                <button style={{ border: "none", background: "none", color: "#2563eb", fontSize: "13px", cursor: "pointer" }}
                  onClick={downloadImportTemplate}>下载导入模板</button>
                <input ref={importFileRef} type="file" accept=".xlsx,.csv" style={{ display: "none" }}
                  onChange={(e) => { const f = e.target.files?.[0]; if (f) void handleImportFile(f); }} />
              </div>
              <ul style={{ margin: 0, paddingLeft: "18px", fontSize: "12.5px", color: "#4b5563", lineHeight: 2 }}>
                <li>支持导入格式为 CSV（下载模板后用 Excel 填写，保存/另存为 CSV 即可，UTF-8 与国内 Excel 默认编码均支持）</li>
                <li>模板中的表头不可更改，不可删除</li>
                <li>单次导入最大支持 1000 行</li>
          <li>必须先选择导入负责人：文件中负责人与所选不符的行将逐行拒绝（复查校验）；模板为 Excel(.xlsx)，也兼容 CSV</li>
                <li>本月清货目标：按 ItemID 匹配，已有清货目标则覆盖，没有则新增（写入月度规划同底座，与页面单条录入同规则）</li>
                <li>其他渠道清货：按 SKU+渠道 匹配，已存在则覆盖更新并激活，不存在则新增</li>
              </ul>
              {importResult.length > 0 && (
                <div style={{ marginTop: "14px", background: "#f8fafc", border: "1px solid #e2e8f0", borderRadius: "8px", padding: "10px 12px", fontSize: "12.5px", lineHeight: 1.9, maxHeight: "220px", overflowY: "auto" }}>
                  {importResult.map((l, i) => (
                    <div key={i} style={{ color: l.startsWith("❌") || l.startsWith("·") ? "#b91c1c" : "#166534" }}>{l}</div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {showColCfg && (
        <div style={{ position: "fixed", inset: 0, background: "rgba(15,23,42,0.4)", zIndex: 1000, display: "flex", alignItems: "center", justifyContent: "center" }}
          onClick={() => setShowColCfg(false)}>
          <div style={{ background: "#fff", borderRadius: "12px", width: "680px", maxHeight: "78vh", display: "flex", flexDirection: "column", overflow: "hidden", boxShadow: "0 8px 32px rgba(0,0,0,0.18)" }}
            onClick={(e) => e.stopPropagation()}>
            <div style={{ padding: "12px 16px", borderBottom: "1px solid #e5e7eb", display: "flex", justifyContent: "space-between", alignItems: "center" }}>
              <span style={{ fontSize: "14px", fontWeight: 700, color: "#374151" }}>列配置</span>
              <button onClick={() => setShowColCfg(false)} style={{ border: "none", background: "none", fontSize: "18px", cursor: "pointer", color: "#9ca3af" }}>×</button>
            </div>
            <div style={{ display: "flex", flex: 1, overflow: "hidden" }}>
              <div style={{ flex: 1, padding: "10px 14px", overflowY: "auto" }}>
                {ALL_COLS.map((col) => (
                  <label key={col} style={{ display: "flex", alignItems: "center", gap: "6px", padding: "4px 0", cursor: "pointer", fontSize: "13px" }}>
                    <input type="checkbox" checked={cfgSelected.includes(col)}
                      onChange={() => {
                        setCfgSelected((prev) => prev.includes(col) ? prev.filter((c) => c !== col) : [...prev, col]);
                        setCfgPins((prev) => prev.filter((c) => c !== col));
                      }} />
                    <span style={{ color: "#374151" }}>{col}</span>
                  </label>
                ))}
              </div>
              <div style={{ width: "230px", borderLeft: "1px solid #e5e7eb", padding: "10px 10px", overflowY: "auto", background: "#f8fafc" }}>
                <div style={{ fontSize: "12px", color: "#64748b", marginBottom: "2px" }}>已选 {cfgSelected.length} 列 · 拖动调顺序</div>
                <div style={{ fontSize: "11px", color: "#94a3b8", marginBottom: "6px" }}>📌最多固定{MAX_PINNED_COLUMNS}项（表格左侧冻结）</div>
                {cfgOrderedSelected.map((col, idx) => {
                  const isPin = cfgPins.includes(col);
                  return (
                    <div key={col} draggable
                      onDragStart={() => { dragColIdxRef.current = idx; }}
                      onDragOver={(e) => e.preventDefault()}
                      onDrop={() => {
                        const from = dragColIdxRef.current;
                        dragColIdxRef.current = null;
                        if (from === null || from === idx) return;
                        const view = [...cfgOrderedSelected];
                        const [moved] = view.splice(from, 1);
                        view.splice(idx, 0, moved);
                        setCfgSelected(view);
                      }}
                      style={{ display: "flex", alignItems: "center", gap: "4px", padding: "4px 2px", fontSize: "12px",
                        borderRadius: "4px", cursor: "grab", background: isPin ? "#eef2ff" : "transparent", borderBottom: "1px solid #f1f5f9" }}>
                      <span style={{ color: "#cbd5e1", fontSize: "13px", lineHeight: 1 }} title="拖动排序">⠿</span>
                      <span style={{ flex: 1, overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap" }}>
                        {isPin && <span style={{ fontSize: "10px" }}>📌</span>}{col}
                      </span>
                      <span onClick={() => setCfgSelected((prev) => [col, ...prev.filter((c) => c !== col)])} title="置顶"
                        style={{ color: "#64748b", cursor: "pointer", fontSize: "12px" }}>⬆</span>
                      <span onClick={() => setCfgPins((prev) => {
                          if (prev.includes(col)) return prev.filter((c) => c !== col);
                          if (prev.length >= MAX_PINNED_COLUMNS) { window.alert(`最多可固定${MAX_PINNED_COLUMNS}项`); return prev; }
                          return [...prev, col];
                        })} title={isPin ? "取消固定" : "固定（左侧冻结）"}
                        style={{ color: isPin ? "#2563eb" : "#94a3b8", cursor: "pointer", fontSize: "12px" }}>📌</span>
                      <span onClick={() => {
                          setCfgSelected((prev) => prev.filter((c) => c !== col));
                          setCfgPins((prev) => prev.filter((c) => c !== col));
                        }} title="删除"
                        style={{ color: "#ef4444", cursor: "pointer", fontSize: "14px" }}>×</span>
                    </div>
                  );
                })}
              </div>
            </div>
            <div style={{ padding: "10px 16px", borderTop: "1px solid #e5e7eb", display: "flex", gap: "8px", justifyContent: "flex-end" }}>
              <button style={btn} onClick={() => { setCfgSelected(ALL_COLS); setCfgPins([]); }}>重置默认</button>
              <button style={btn} onClick={() => setShowColCfg(false)}>取消</button>
              <button style={primaryBtn} onClick={applyColCfg}>应用</button>
            </div>
          </div>
        </div>
      )}

      {msg && <div style={{ ...card, color: msg.includes("失败") ? "#b91c1c" : "#166534" }}>{msg}</div>}

      {showAdd && (
        <div style={{ ...card, background: "#fafaf9", border: "1px solid #d6d3d1" }}>
          <div style={{ fontWeight: 700, marginBottom: "10px" }}>添加其他渠道清货（SKU 维度）</div>
          <div style={{ display: "flex", gap: "8px", flexWrap: "wrap", alignItems: "center" }}>
            <input style={{ ...sel, width: "130px" }} placeholder="SKU *" value={addSku}
              onChange={(e) => setAddSku(e.target.value)} onBlur={() => void autoLookup()} />
            <select style={{ ...sel, width: "130px" }} value={addOwner} onChange={(e) => setAddOwner(e.target.value)}>
              <option value="">负责人 *</option>
              {(ownersAll.length ? ownersAll : owners).map((o) => <option key={o} value={o}>{o}</option>)}
            </select>
            <select style={sel} value={addChannel} onChange={(e) => setAddChannel(e.target.value)}>
              <option value="沃尔玛">渠道：沃尔玛</option>
              <option value="亚马逊">渠道：亚马逊</option>
              <option value="希音">渠道：希音</option>
              <option value="TEMU">渠道：TEMU</option>
              <option value="TikTok">渠道：TikTok</option>
            </select>
            <input style={{ ...sel, width: "160px" }}
              placeholder={addChannel === "亚马逊" ? "产品ID(ASIN) *" : addChannel === "希音" ? "产品ID(平台SKC) *" : addChannel === "TEMU" ? "产品ID(平台SPU) *" : addChannel === "TikTok" ? "产品ID(product_id) *" : "产品ID(ItemID) *"}
              value={addRef} onChange={(e) => setAddRef(e.target.value)} />
            <input style={{ ...sel, width: "110px" }} type="number" min={0} placeholder="库存数量" value={addStock} onChange={(e) => setAddStock(e.target.value)} />
            <input style={{ ...sel, width: "160px" }} placeholder="备注(选填)" value={addRemark} onChange={(e) => setAddRemark(e.target.value)} />
            <button style={primaryBtn} onClick={() => void doAdd()} disabled={saving}>{saving ? "提交中…" : "确认添加"}</button>
            <button style={btn} onClick={() => setShowAdd(false)}>取消</button>
          </div>
          {lookupInfo && <div style={{ marginTop: "8px", fontSize: "12px", color: "#6b7280" }}>{lookupInfo}</div>}
        </div>
      )}

      <style>{`.cc-row:hover td { background: #eef2ff; } .lx-colresize{position:absolute;top:0;right:-4px;width:9px;height:100%;cursor:col-resize;user-select:none;z-index:5;display:flex;align-items:center;justify-content:center} .lx-colresize::after{content:'';width:2px;height:56%;background:#dadce0;border-radius:1px;transition:background .12s,height .12s,width .12s} .lx-colresize:hover::after{background:#1a73e8;width:3px;height:100%}`}</style>
      <div style={{ ...card, padding: 0, overflow: "auto", maxHeight: "62vh" }}>
        <table style={{ width: "100%", borderCollapse: "collapse", tableLayout: "fixed" }}>
          <thead>
            <tr>
              {visibleCols.map((h) => (
                <th key={h}
                  style={{ ...th, width: colWidths[h] ?? COL_W[h], cursor: SORT_VAL[h] ? "pointer" : "default", userSelect: "none", zIndex: 2,
                    ...(pinnedCols.includes(h) ? { position: "sticky" as const, left: pinLeft[h], zIndex: 4, background: "#f1f5f9" } : {}) }}
                  onClick={() => onSort(h)}
                  title={SORT_VAL[h] ? "点击排序，再点切换升/降序" : undefined}>
                  {h}{SORT_VAL[h] ? (sortCol === h ? (sortDir === 1 ? " ↑" : " ↓") : <span style={{ color: "#c7cbd4" }}> ⇅</span>) : ""}
                  {COL_INFO[h] ? <span title={COL_INFO[h]} onClick={(e) => e.stopPropagation()} style={{ marginLeft: "3px", color: "#9ca3af", cursor: "help" }}>ⓘ</span> : null}
                  <span className="lx-colresize" onMouseDown={(e) => startResize(e, h)} onClick={(e) => e.stopPropagation()} />
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {pagedRows.map((r) => {
              const cells: Record<string, JSX.Element> = {
                "SKU": <td key="sku" style={td}>{r.sku}</td>,
                "产品ID": <td key="pid" style={td}>{r.platform_ref
                  ? (refPrefix(r.channel) === "ItemID"
                      ? <>{refPrefix(r.channel)}:<ItemIdLink itemId={r.platform_ref} isWalmart /></>
                      : `${refPrefix(r.channel)}:${r.platform_ref}`)
                  : "-"}</td>,
                "渠道": <td key="ch" style={td}>{r.channel}</td>,
                "店铺": <td key="st" style={{ ...td, color: "#6b7280" }}>{r.row_type === "manual" ? "—" : r.store_name}</td>,
                "负责人": <td key="ow" style={td}>{r.owner}</td>,
                "进入清货": <td key="en" style={td}>{r.entered_at || "2026-07-31"}</td>,
                "库存": <td key="stk" style={{ ...td, textAlign: "right", color: r.stock === 0 ? "#166534" : undefined, fontWeight: r.stock === 0 ? 700 : undefined }}>{r.stock}</td>,
                "在途": <td key="ib" style={{ ...td, textAlign: "right" }}>{r.row_type === "manual" ? <span style={{ color: "#9ca3af" }} title="其他渠道不接入在途">—</span> : r.inbound}</td>,
                "清货库存成本": <td key="scost" style={{ ...td, textAlign: "right" }}>
                  {r.stock_cost === null
                    ? (r.row_type === "manual" ? "—" : <span style={{ color: "#dc2626" }} title="产品管理成本配置缺采购/头程成本">缺成本</span>)
                    : <span style={{ color: r.stock_cost === 0 ? "#166534" : undefined }}
                        title={`(采购${r.purchase_cost ?? 0}+头程${r.first_mile_cost ?? 0})×${r.stock}`}>
                        ¥ {r.stock_cost.toLocaleString(undefined, { maximumFractionDigits: 0 })}
                      </span>}
                </td>,
                "7日日销": <td key="d7" style={{ ...td, textAlign: "right" }}>{r.daily7 === null ? "—" : r.daily7}</td>,
                "本月目标": <td key="mt" style={td}>
          {r.row_type === "manual" ? (
            <span>
              <input style={{ ...sel, padding: "2px 6px", fontSize: "12px", width: "56px", textAlign: "right" }}
                value={targetDrafts[r.row_key] ?? (r.month_target !== null ? String(r.month_target) : "")}
                placeholder="未设"
                disabled={targetSavingKey === r.row_key}
                onChange={(e) => setTargetDrafts((prev) => ({ ...prev, [r.row_key]: e.target.value }))}
                onKeyDown={(e) => { if (e.key === "Enter") void saveManualField(r, "target"); }} />
              <button style={{ ...btn, padding: "2px 7px", fontSize: "11px", marginLeft: "4px" }}
                disabled={targetSavingKey === r.row_key}
                onClick={() => void saveManualField(r, "target")}>{targetSavingKey === r.row_key ? "…" : "存"}</button>
              {r.month_target !== null
                ? <span style={{ display: "block", color: "#9ca3af", fontSize: "10.5px" }}>{r.target_updated_by} {r.target_updated_at}</span>
                : <span style={{ display: "block", color: "#dc2626", fontSize: "10.5px" }}>⚠ 未设目标</span>}
            </span>
          ) : (
                    <span>
                      <input style={{ ...sel, padding: "2px 6px", fontSize: "12px", width: "56px", textAlign: "right" }}
                        value={targetDrafts[r.row_key] ?? (r.month_target !== null ? String(r.month_target) : "")}
                        placeholder="未设"
                        disabled={targetSavingKey === r.row_key}
                        onChange={(e) => setTargetDrafts((prev) => ({ ...prev, [r.row_key]: e.target.value }))}
                        onKeyDown={(e) => { if (e.key === "Enter") void saveTarget(r); }} />
                      <button style={{ ...btn, padding: "2px 7px", fontSize: "11px", marginLeft: "4px" }}
                        disabled={targetSavingKey === r.row_key}
                        onClick={() => void saveTarget(r)}>{targetSavingKey === r.row_key ? "…" : "存"}</button>
                      {r.month_target !== null
                        ? <span style={{ display: "block", color: "#9ca3af", fontSize: "10.5px" }}>{r.target_updated_by} {r.target_updated_at}</span>
                        : <span style={{ display: "block", color: "#dc2626", fontSize: "10.5px" }}>⚠ 未设目标</span>}
                    </span>
                  )}
                </td>,
                "本月已清": <td key="mc" style={{ ...td, textAlign: "right" }}>{r.row_type === "manual" ? (r.month_cleared ?? "—") : (r.month_cleared ?? 0)}</td>,
                "达成率": <td key="mr" style={td}>
                  {r.month_target === null || r.month_target <= 0 ? <span style={{ color: "#9ca3af" }}>—</span> : (() => {
                    const pct = Math.round((r.month_cleared ?? 0) / r.month_target * 100);
                    if (r.stock === 0) return <span style={{ color: "#166534", fontWeight: 700 }}>✔ 已清完 ({pct}%)</span>;
                    return (
                      <span>
                        <span style={{ display: "inline-block", width: "56px", height: "8px", background: "#e5e7eb", borderRadius: "4px", verticalAlign: "middle", marginRight: "5px" }}>
                          <span style={{ display: "block", height: "8px", borderRadius: "4px", width: `${Math.min(pct, 100)}%`, background: pct >= 90 ? "#16a34a" : "#f59e0b" }} />
                        </span>
                        {pct}%
                      </span>
                    );
                  })()}
                </td>,
                "预计清完": <td key="dc" style={{ ...td, textAlign: "right" }}>{r.stock === 0 ? "已清完" : r.days_to_clear === null ? "—" : `${r.days_to_clear}天`}</td>,
                "预计清货结束": <td key="ee" style={td}>
                  <input type="date" style={{ ...sel, padding: "2px 6px", fontSize: "12px", width: "125px" }}
                    value={r.expect_end || ""}
                    onChange={(e) => void saveExpect(r, e.target.value)} />
                </td>,
                "状态": <td key="stt" style={td}><span style={stateBadge(r.state)}>{r.state}</span>{r.remark ? <span style={{ color: "#9ca3af", fontSize: "11px" }}><br />{r.remark}</span> : null}</td>,
                "操作": <td key="op" style={td}>
                  {r.row_type === "manual" ? (
                    <span style={{ display: "flex", gap: "6px" }}>
                      <button style={{ ...btn, padding: "2px 8px", fontSize: "12px" }} onClick={() => void manualEditStock(r)}>改库存</button>
                      <button style={{ ...btn, padding: "2px 8px", fontSize: "12px" }} onClick={() => void manualStatus(r, "done")}>清货完成</button>
                      <button style={{ ...btn, padding: "2px 8px", fontSize: "12px", color: "#b91c1c" }} onClick={() => void manualStatus(r, "removed")}>移出</button>
                    </span>
                  ) : (r.state === "待审批" && r.approval_id) ? (
                    <span style={{ display: "flex", gap: "6px" }}>
                      <button style={{ ...btn, padding: "2px 8px", fontSize: "12px", color: "#15803d" }} onClick={() => void ccApprove(r)}>同意</button>
                      <button style={{ ...btn, padding: "2px 8px", fontSize: "12px", color: "#b91c1c" }} onClick={() => void ccReject(r)}>驳回</button>
                    </span>
                  ) : "—"}
                </td>,
              };
              return (
                <tr className="cc-row" key={r.row_key}>
                  {visibleCols.map((c) => pinnedCols.includes(c)
                    ? cloneElement(cells[c], {
                        style: { ...(cells[c].props as { style?: React.CSSProperties }).style,
                          position: "sticky", left: pinLeft[c], zIndex: 1, background: "#fff" },
                      })
                    : cells[c])}
                </tr>
              );
            })}
            {!rows.length && !loading && (
              <tr><td style={{ ...td, textAlign: "center", color: "#6b7280" }} colSpan={visibleCols.length}>暂无清货产品</td></tr>
            )}
          </tbody>
          <tfoot>
            <tr>
              {visibleCols.map((c, i) => {
                const numFn: Record<string, (r: Row) => number> = {
                  "库存": (r) => r.stock || 0,
                  "在途": (r) => r.row_type === "manual" ? 0 : (r.inbound || 0),
                  "清货库存成本": (r) => r.stock_cost || 0,
                  "本月目标": (r) => r.month_target || 0,
                  "本月已清": (r) => r.month_cleared || 0,
                };
                const content = i === 0 ? `总计（${totalRows}行）` : (numFn[c] ? String(Math.round(sumOf(numFn[c]) * 100) / 100) : "");
                return (
                  <td key={c} style={{ ...td, fontWeight: 700, background: "#f8fafc", position: "sticky" as const, bottom: 0, textAlign: numFn[c] ? "right" : "left",
                    ...(pinnedCols.includes(c) ? { left: pinLeft[c], zIndex: 3 } : {}) }}>{content}</td>
                );
              })}
            </tr>
          </tfoot>
        </table>
      </div>
      <div style={{ display: "flex", alignItems: "center", gap: "6px", marginTop: "8px", flexWrap: "wrap" }}>
        <span style={{ fontSize: "12px", color: "#6b7280" }}>每页</span>
        {[50, 100, 200].map((ps) => (
          <button key={ps} style={{ ...btn, padding: "3px 10px", fontSize: "12px", ...(pageSize === ps ? { background: "#4f46e5", color: "#fff", border: "1px solid #4f46e5" } : {}) }}
            onClick={() => { setPageSize(ps); setPage(1); }}>{ps}</button>
        ))}
        <button style={{ ...btn, padding: "3px 10px", fontSize: "12px" }} disabled={curPage <= 1} onClick={() => setPage(1)}>首页</button>
        <button style={{ ...btn, padding: "3px 10px", fontSize: "12px" }} disabled={curPage <= 1} onClick={() => setPage(curPage - 1)}>上一页</button>
        <span style={{ fontSize: "12px", color: "#374151" }}>第 {curPage}/{totalPages} 页</span>
        <button style={{ ...btn, padding: "3px 10px", fontSize: "12px" }} disabled={curPage >= totalPages} onClick={() => setPage(curPage + 1)}>下一页</button>
        <button style={{ ...btn, padding: "3px 10px", fontSize: "12px" }} disabled={curPage >= totalPages} onClick={() => setPage(totalPages)}>末页</button>
      </div>
      <div style={{ fontSize: "12px", color: "#6b7280", marginTop: "8px" }}>
        口径：沃尔玛行库存/在途取最新快照，7日日销=近7个数据日均值，预计清完=库存÷7日日销；
        其他渠道行（亚马逊ASIN/希音SKC）库存为人工维护，日销待亚马逊销量接入（批⑤）后自动。
        清尾卡（周五10:16）、清零归档卡（清零+7天）将在批③自动化。
        本月目标写入月度规划同底座（指标=清货≥件，同一条记录两边同步）；本月已清=当月销量合计（T-2滞后，移仓/弃置/其他渠道不计入）；
        清货库存成本=(采购+头程)×当前库存（产品管理成本配置同源，人民币）。
      </div>
    </div>
  );
}
