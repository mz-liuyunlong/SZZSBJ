/**
 * ClearanceCenter.tsx - 清货中心 Tab（批②，2026-07-21 v2）
 * 表头=SKU、平台ID（沃尔玛=ItemID/亚马逊=ASIN/希音=平台SKC）
 * 其他渠道台账：SKU维度，人工负责人/库存/渠道/平台识别号
 */
import { cloneElement, useCallback, useEffect, useRef, useState } from "react";
import LxMultiSelect from "./LxMultiSelect";
import { ItemIdLink } from "./ItemIdLink";

interface Row {
  row_type: "auto" | "manual";
  manual_id: number | null;
  approval_id?: number | null;
  sku: string;
  mskus: string;
  platform_ref: string;
  channel: string;
  store_id: string;
  store_name: string;
  item_id: string;
  owner: string;
  entered_at: string;
  stock: number;
  inbound: number;
  daily7: number | null;
  days_to_clear: number | null;
  remark: string;
  state: string;
  row_key: string;
  expect_end: string;
  // 2026-07-23 本月清货目标 + 清货库存成本
  month_target: number | null;
  target_updated_by: string;
  target_updated_at: string;
  month_cleared: number | null;
  purchase_cost: number | null;
  first_mile_cost: number | null;
  stock_cost: number | null;
}

interface Kpi {
  clearing: number; pending: number; cleared: number; other_channel: number; friday_due: number;
  month_target_total: number; month_cleared_on_target: number; no_target_count: number;
  stock_cost_total: number; cost_missing_count: number;
}

const card: React.CSSProperties = { background: "#fff", border: "1px solid #e5e7eb", borderRadius: "10px", padding: "14px 16px", marginBottom: "12px" };
const th: React.CSSProperties = { textAlign: "left", padding: "8px 10px", fontSize: "12px", color: "#6b7280", background: "#f9fafb", whiteSpace: "nowrap", position: "sticky", top: 0 };
const td: React.CSSProperties = { padding: "7px 10px", fontSize: "12px", borderTop: "1px solid #f3f4f6", whiteSpace: "nowrap" };
const btn: React.CSSProperties = { padding: "5px 14px", borderRadius: "6px", border: "1px solid #d1d5db", background: "#fff", fontSize: "13px", cursor: "pointer" };
const primaryBtn: React.CSSProperties = { ...btn, background: "#4f46e5", color: "#fff", border: "1px solid #4f46e5" };
const sel: React.CSSProperties = { padding: "5px 8px", borderRadius: "6px", border: "1px solid #d1d5db", fontSize: "13px" };

function stateBadge(state: string): React.CSSProperties {
  const base: React.CSSProperties = { padding: "1px 8px", borderRadius: "9px", fontSize: "11px", whiteSpace: "nowrap" };
  if (state === "待审批") return { ...base, background: "#fef3c7", color: "#92400e" };
  if (state === "清货中") return { ...base, background: "#dbeafe", color: "#1d4ed8" };
  if (state === "清零待归档") return { ...base, background: "#dcfce7", color: "#166534" };
  return { ...base, background: "#f3f4f6", color: "#4b5563" };
}

