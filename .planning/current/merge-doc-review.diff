+  test -f "$file" || { printf 'MISSING: %s\n' "$file"; exit 1; }
+  printf '%s ' "$name"
+  git hash-object --no-filters -- "$file"
+  grep -nE '^(revision|down_revision)([[:space:]:=]|$)' "$file"
+done
