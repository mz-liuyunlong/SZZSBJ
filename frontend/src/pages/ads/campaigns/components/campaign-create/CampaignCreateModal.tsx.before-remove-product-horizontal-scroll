function ProductPickerSection({ type }: { type: CampaignCreateType }) {
  const [keyword, setKeyword] = useState("");
  const [selectedProducts, setSelectedProducts] = useState<SelectedProduct[]>(
    [],
  );

  const maxProducts = maxProductsByType[type];
  const minProducts = minProductsByType[type];

  const selectedProductIds = useMemo(
    () => new Set(selectedProducts.map((item) => item.id)),
    [selectedProducts],
  );

  const filteredProducts = useMemo(() => {
    const normalizedKeyword = keyword.trim().toLowerCase();

    return productPool.filter((product) => {
      if (selectedProductIds.has(product.id)) return false;
      if (!normalizedKeyword) return true;
      return (
        product.name.toLowerCase().includes(normalizedKeyword) ||
        product.id.includes(normalizedKeyword)
      );
    });
  }, [keyword, selectedProductIds]);

  const addProduct = (product: ProductCandidate) => {
    setSelectedProducts((current) => {
      if (
        current.length >= maxProducts ||
        current.some((item) => item.id === product.id)
      )
        return current;
      return [...current, { ...product, bid: 0.45, status: "已添加" }];
    });
  };

  const addAll = () => {
    setSelectedProducts((current) => {
      const currentIds = new Set(current.map((item) => item.id));
      const nextProducts = filteredProducts
        .filter((product) => !currentIds.has(product.id))
        .slice(0, Math.max(maxProducts - current.length, 0))
        .map((product) => ({ ...product, bid: 0.45, status: "已添加" }));

      return [...current, ...nextProducts];
    });
  };

  const removeProduct = (id: string) => {
    setSelectedProducts((current) => current.filter((item) => item.id !== id));
  };

  const availableColumns: ColumnsType<ProductCandidate> = [
    {
      title: "商品名称",
      dataIndex: "name",
      width: 260,
      render: (value: string) => (
        <span title={value}>{truncateText(value)}</span>
      ),
    },
    { title: "商品ID", dataIndex: "id", width: 150 },
    { title: "可售库存", dataIndex: "availableQuantity", width: 110 },
    {
      title: "操作",
      key: "action",
      width: 90,
      render: (_, record) => (
        <Button type="link" onClick={() => addProduct(record)}>
          添加
        </Button>
      ),
    },
  ];

  const selectedColumns: ColumnsType<SelectedProduct> = [
    {
      title: "商品名称",
      dataIndex: "name",
      width: 260,
      render: (value: string) => (
        <span title={value}>{truncateText(value)}</span>
      ),
    },
    { title: "商品ID", dataIndex: "id", width: 150 },
    {
      title:
        type === "SP" ? (
          <Space size={4}>
            <span>竞价</span>
            <Button type="link" size="small">
              批量
            </Button>
          </Space>
        ) : (
          "状态"
        ),
      dataIndex: type === "SP" ? "bid" : "status",
      width: 130,
      render: (_, record) =>
        type === "SP" ? (
          <PriceInput
            value={record.bid}
            onChange={(value) => {
              setSelectedProducts((current) =>
                current.map((item) =>
                  item.id === record.id ? { ...item, bid: value ?? 0 } : item,
                ),
              );
            }}
          />
        ) : (
          (record.status ?? "--")
        ),
    },
    {
      title: "操作",
      key: "action",
      width: 90,
      render: (_, record) => (
        <Button
          type="link"
          danger
          icon={<DeleteOutlined />}
          onClick={() => removeProduct(record.id)}
        >
          移除
        </Button>
      ),
    },
  ];

  return (
    <SectionCard title="添加广告商品">
      <div className="campaign-create-modal__transfer">
        <div className="campaign-create-modal__transfer-pane">
          <div className="campaign-create-modal__pane-toolbar">
            <Input
              allowClear
              className="campaign-create-modal__search"
              prefix={<SearchOutlined />}
              placeholder="请输入商品名称、商品ID查询"
              value={keyword}
              onChange={(event) => setKeyword(event.target.value)}
            />
            <Button type="link" onClick={addAll}>
              添加全部
            </Button>
          </div>

          <Table<ProductCandidate>
            rowKey="id"
            size="small"
            columns={availableColumns}
            dataSource={filteredProducts}
            pagination={{
              pageSize: 10,
              showSizeChanger: false,
              showTotal: (total) => `共 ${total} 条`,
            }}
            scroll={{ x: 600, y: 360 }}
          />
        </div>

        <div className="campaign-create-modal__transfer-pane campaign-create-modal__transfer-pane--selected">
          <div className="campaign-create-modal__pane-toolbar">
            <Typography.Text>
              已选择 <strong>{selectedProducts.length}</strong> 个商品
              <Typography.Text type="secondary">
                （最多可添加{maxProducts}个
                {minProducts ? `，最少${minProducts}个` : ""}）
              </Typography.Text>
            </Typography.Text>
            <Button type="link" onClick={() => setSelectedProducts([])}>
              移除全部
            </Button>
          </div>

          <Table<SelectedProduct>
            rowKey="id"
            size="small"
            columns={selectedColumns}
            dataSource={selectedProducts}
            locale={{ emptyText: <Empty description="暂无数据" /> }}
            pagination={false}
            scroll={{ x: 620, y: 420 }}
          />
        </div>
      </div>

      <Form.Item name="selectedProducts" hidden initialValue={selectedProducts}>
        <Input />
      </Form.Item>
    </SectionCard>
  );
}

function KeywordManualSection() {
  const [manualText, setManualText] = useState("");
  const [matchTypes, setMatchTypes] = useState<MatchType[]>(["broad"]);
  const [bid, setBid] = useState<number | null>(null);
  const [selectedKeywords, setSelectedKeywords] = useState<SelectedKeyword[]>(
    [],
  );

  const addKeywords = () => {
    const keywords = manualText
      .split(/\n+/)
      .map((item) => item.trim())
      .filter(Boolean);

    if (keywords.length === 0 || matchTypes.length === 0) return;

    setSelectedKeywords((current) => {
      const currentKeys = new Set(
        current.map(
          (item) => `${item.keyword.toLowerCase()}::${item.matchType}`,
        ),
      );
      const nextItems: SelectedKeyword[] = [];

      keywords.forEach((keyword) => {
        matchTypes.forEach((matchType) => {
          const key = `${keyword.toLowerCase()}::${matchType}`;
          if (currentKeys.has(key)) return;

          nextItems.push({
            id: `KW-${Date.now()}-${nextItems.length}`,
            keyword,
            matchType,
            suggestedBid: undefined,
            bid: bid ?? 0,
          });
          currentKeys.add(key);
        });
      });

      return [...current, ...nextItems].slice(0, 1000);
    });

    setManualText("");
  };

  const removeKeyword = (id: string) => {
    setSelectedKeywords((current) => current.filter((item) => item.id !== id));
  };

  const selectedColumns: ColumnsType<SelectedKeyword> = [
    { title: "关键词", dataIndex: "keyword", width: 220 },
    {
      title: "匹配方式",
      dataIndex: "matchType",
      width: 120,
      render: (value: MatchType) => matchTypeLabel[value],
    },
    {
      title: "建议竞价",
      dataIndex: "suggestedBid",
      width: 120,
      render: (value?: number) => (value == null ? "--" : `$${value}`),
    },
    {
      title: "竞价",
      dataIndex: "bid",
      width: 130,
      render: (_, record) => (
        <PriceInput
          value={record.bid}
          onChange={(value) => {
            setSelectedKeywords((current) =>
              current.map((item) =>
                item.id === record.id ? { ...item, bid: value ?? 0 } : item,
              ),
            );
          }}
        />
      ),
    },
    {
      title: "操作",
      key: "action",
      width: 90,
      render: (_, record) => (
        <Button
          type="link"
          danger
          icon={<DeleteOutlined />}
          onClick={() => removeKeyword(record.id)}
        >
          移除
        </Button>
      ),
    },
  ];

  return (
    <SectionCard title="添加关键词">
      <div className="campaign-create-modal__transfer">
        <div className="campaign-create-modal__transfer-pane">
          <Tabs
            activeKey="manual"
            items={[{ key: "manual", label: "手动输入" }]}
          />

          <Space
            direction="vertical"
            size={18}
            className="campaign-create-modal__keyword-input-area"
          >
            <Space align="center">
              <span className="campaign-create-modal__sub-label">竞价：</span>
              <PriceInput value={bid} onChange={setBid} />
            </Space>

            <Space align="center" wrap>
              <span className="campaign-create-modal__sub-label">
                匹配方式：
              </span>
              <Checkbox
                checked={matchTypes.includes("broad")}
                onChange={(event) =>
                  setMatchTypes((current) =>
                    event.target.checked
                      ? Array.from(new Set([...current, "broad"]))
                      : current.filter((item) => item !== "broad"),
                  )
                }
              >
                广泛
              </Checkbox>
              <Checkbox
                checked={matchTypes.includes("phrase")}
                onChange={(event) =>
                  setMatchTypes((current) =>
                    event.target.checked
                      ? Array.from(new Set([...current, "phrase"]))
                      : current.filter((item) => item !== "phrase"),
                  )
                }
              >
                词组
              </Checkbox>
              <Checkbox
                checked={matchTypes.includes("exact")}
                onChange={(event) =>
                  setMatchTypes((current) =>
                    event.target.checked
                      ? Array.from(new Set([...current, "exact"]))
                      : current.filter((item) => item !== "exact"),
                  )
                }
              >
                精准
              </Checkbox>
            </Space>

            <Input.TextArea
              rows={12}
              placeholder="请输入关键词，一行一个关键词"
              value={manualText}
              onChange={(event) => setManualText(event.target.value)}
            />

            <Button
              type="primary"
              disabled={!manualText.trim()}
              onClick={addKeywords}
            >
              添加关键词
            </Button>
          </Space>
        </div>

        <div className="campaign-create-modal__transfer-pane campaign-create-modal__transfer-pane--selected">
          <div className="campaign-create-modal__pane-toolbar">
            <Typography.Text>
              已选择 <strong>{selectedKeywords.length}</strong> 个关键词
              <Typography.Text type="secondary">
                （最多可添加1000个）
              </Typography.Text>
            </Typography.Text>
            <Button type="link" onClick={() => setSelectedKeywords([])}>
              全部移除
            </Button>
          </div>

          <Table<SelectedKeyword>
            rowKey="id"
            size="small"
            columns={selectedColumns}
            dataSource={selectedKeywords}
            locale={{ emptyText: <Empty description="暂无数据" /> }}
            pagination={false}
            scroll={{ x: 680, y: 420 }}
          />
        </div>
      </div>

      <Form.Item name="selectedKeywords" hidden initialValue={selectedKeywords}>
        <Input />
      </Form.Item>
    </SectionCard>
  );
}

function CampaignCreateModal({
  open,
  initialType = "SP",
  onCancel,
  onSubmit,
}: CampaignCreateModalProps) {
  const [form] = Form.useForm();
  const [campaignType, setCampaignType] =
    useState<CampaignCreateType>(initialType);

  const resetModal = () => {
    form.resetFields();
    setCampaignType(initialType);
  };

  const handleCancel = () => {
    resetModal();
    onCancel();
  };

  const handleSubmit = async () => {
    const values = await form.validateFields();

    onSubmit({
      campaignType,
      values,
      products: [],
      keywords: [],
    });

    resetModal();
  };

  return (
    <Modal
      open={open}
      title="创建广告活动"
      width={1280}
      centered
      destroyOnHidden
      onCancel={handleCancel}
      footer={[
        <Button key="cancel" onClick={handleCancel}>
          取消
        </Button>,
        <Button key="submit" type="primary" onClick={() => void handleSubmit()}>
          创建广告活动
        </Button>,
      ]}
      className="campaign-create-modal"
    >
      <Radio.Group
        className="campaign-create-modal__type-switch"
        value={campaignType}
        optionType="button"
        buttonStyle="solid"
        onChange={(event) => {
          const nextType = event.target.value as CampaignCreateType;
          setCampaignType(nextType);
          form.resetFields();
        }}
      >
        <Radio.Button value="SP">SP广告</Radio.Button>
        <Radio.Button value="SB">SB广告</Radio.Button>
        <Radio.Button value="SV">SV广告</Radio.Button>
      </Radio.Group>

      <Form
        form={form}
        layout="horizontal"
        labelCol={{ flex: "96px" }}
        wrapperCol={{ flex: "420px" }}
        colon={false}
        requiredMark
        className="campaign-create-modal__form"
      >
        <BaseSettingsSection type={campaignType} />
        <ScheduleBudgetSection />

        {campaignType === "SP" && (
          <>
            <SpTargetingSettingsSection />
            <SpBiddingStrategySection />
            <SpBidMultipliersSection />
          </>
        )}

        <AdGroupSettingsSection />

        {campaignType === "SB" && <ImageTitleSection />}
        {campaignType === "SV" && <VideoCreativeSection />}

        <ProductPickerSection type={campaignType} />

        {(campaignType === "SB" || campaignType === "SV") && (
          <KeywordManualSection />
        )}
      </Form>
    </Modal>
  );
}

export default CampaignCreateModal;
