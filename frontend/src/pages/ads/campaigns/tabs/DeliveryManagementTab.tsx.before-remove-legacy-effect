  const toggleAllCurrentDetailSelection = (checked: boolean) => {
    const visibleIds = new Set(currentDetailIds);
    setDetailSelectedRowKeys((current) => {
      const currentIds = new Set(current.map(String));
      if (checked) {
        visibleIds.forEach((id) => currentIds.add(id));
      } else {
        visibleIds.forEach((id) => currentIds.delete(id));
      }
      return Array.from(currentIds);
    });
  };

  const campaignColumns: ProColumns<AdsCampaign>[] = [
    {
      key: "selection",
