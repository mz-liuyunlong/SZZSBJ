function DeliveryManagementTab() {
  const [messageApi, messageContextHolder] = message.useMessage();
  const [modalApi, modalContextHolder] = Modal.useModal();
  const [rows, setRows] = useState<AdsCampaign[]>(campaignRows);
  const [budgetDrafts, setBudgetDrafts] = useState<
    Record<string, number | null>
  >({});
  const [keywordBidDrafts, setKeywordBidDrafts] = useState<
    Record<string, number | null>
  >({});
  const [filters, setFilters] = useState<CampaignFilters>(initialFilters);
  const [selectedRowKeys, setSelectedRowKeys] = useState<Key[]>([]);
  const [detailSelectedRowKeys, setDetailSelectedRowKeys] = useState<Key[]>([]);
  const [view, setView] = useState<"list" | "detail" | "create">("list");
  const [activeCampaignId, setActiveCampaignId] = useState(campaignRows[0]?.id);
  const [campaignSettingsOpen, setCampaignSettingsOpen] = useState(false);
  const [campaignSettingsTarget, setCampaignSettingsTarget] =
    useState<AdsCampaign | null>(null);
  const [createAdGroupOpen, setCreateAdGroupOpen] = useState(false);
  const [createCampaignOpen, setCreateCampaignOpen] = useState(false);
  const [createCampaignType, setCreateCampaignType] =
    useState<CampaignCreateType>("SP");

  const openCampaignCreateModal = (nextType: CampaignCreateType) => {
    setCreateCampaignType(nextType);
    setCreateCampaignOpen(true);
  };

  // LEGACY_CREATE_VIEW_REDIRECT: prevent the old full-page create form from opening.
  useEffect(() => {
    if (view !== "create") return;
    setView("list");
    setCreateCampaignOpen(true);
  }, [view]);

  const [createAdProductOpen, setCreateAdProductOpen] = useState(false);
  const [createKeywordOpen, setCreateKeywordOpen] = useState(false);
  const [createNegativeKeywordOpen, setCreateNegativeKeywordOpen] =
    useState(false);
  const [detailTab, setDetailTab] = useState<CampaignDetailTab>("adGroups");
  const [detailDateRange, setDetailDateRange] = useState<
    [string, string] | undefined
  >(actualTodayRange());
  const [activeKpi, setActiveKpi] = useState("impressions");
  const [createForm] = Form.useForm<CreateCampaignValues>();

  const filteredRows = useMemo(() => {
    const keyword = (filters.keyword ?? "").trim().toLocaleLowerCase();
    const selectedAccounts = filters.accounts ?? [];
    const selectedAdTypes = filters.adTypes ?? [];
    const selectedStatuses = filters.statuses ?? [];

    return rows.filter((row) => {
      const searchTarget =
        filters.searchField === "campaignId"
          ? row.id
          : filters.searchField === "account"
            ? row.account
            : row.name;

      return (
        (selectedAccounts.length === 0 ||
          selectedAccounts.includes(row.account)) &&
        (selectedAdTypes.length === 0 || selectedAdTypes.includes(row.type)) &&
        (selectedStatuses.length === 0 ||
          selectedStatuses.includes(row.status)) &&
        (!keyword || searchTarget.toLocaleLowerCase().includes(keyword))
      );
    });
  }, [filters, rows]);

  const activeCampaign = useMemo(
    () => rows.find((row) => row.id === activeCampaignId) ?? rows[0],
    [activeCampaignId, rows],
  );

  const shouldShowDetailDateFilter = detailTab !== "negatives";
  const canBatchUpdateDetailStatus = [
    "adGroups",
    "adItems",
    "keywords",
    "negatives",
  ].includes(detailTab);
  const canBatchAdjustDetailBid = detailTab === "keywords";
  const canAddDetailRowsToNegatives =
    detailTab === "keywords" || detailTab === "searchTerms";
  const selectedDetailActionCount = detailSelectedRowKeys.length;

  const ensureDetailSelection = (actionName: string) => {
    if (selectedDetailActionCount === 0) {
      void messageApi.warning(`请先选择要${actionName}的数据`);
      return false;
    }
    return true;
  };

  const handleBatchDetailStatus = () => {
    if (!ensureDetailSelection("调整状态")) return;
    void messageApi.success(
      `已提交 ${selectedDetailActionCount} 条批量状态调整`,
    );
  };

  const handleBatchDetailBid = () => {
    if (!ensureDetailSelection("调价")) return;
    void messageApi.success(`已提交 ${selectedDetailActionCount} 条批量调价`);
  };

  const handleAddDetailRowsToNegatives = () => {
    if (!ensureDetailSelection("添加为否定关键词")) return;
    void messageApi.success(`已添加 ${selectedDetailActionCount} 条否定关键词`);
  };

  const detailCreateActionLabel: Partial<Record<CampaignDetailTab, string>> = {
    adGroups: "创建广告组",
    adItems: "创建广告商品",
    keywords: "创建关键词",
    negatives: "添加否定关键词",
  };

  const handleDetailCreateAction = () => {
    const label = detailCreateActionLabel[detailTab];
    if (!label) return;

    switch (detailTab as CampaignDetailTab) {
      case "adGroups":
        setCreateAdGroupOpen(true);
        return;
      case "adItems":
        setCreateAdProductOpen(true);
        return;
      case "keywords":
        setCreateKeywordOpen(true);
        return;
      case "negatives":
        setCreateNegativeKeywordOpen(true);
        return;
      default:
        void messageApi.info(`${label}功能已打开`);
    }
  };

  const detailSelectionActions = [
    ...(canBatchUpdateDetailStatus
      ? [
          {
            key: "status",
            label: "批量调整状态",
            disabled: selectedDetailActionCount === 0,
            onClick: handleBatchDetailStatus,
          },
        ]
      : []),
    ...(canBatchAdjustDetailBid
      ? [
          {
            key: "bid",
            label: "批量调价",
            disabled: selectedDetailActionCount === 0,
            onClick: handleBatchDetailBid,
          },
        ]
      : []),
    ...(canAddDetailRowsToNegatives
      ? [
          {
            key: "add-negative",
            label: "添加为否定关键词",
            disabled: selectedDetailActionCount === 0,
            onClick: handleAddDetailRowsToNegatives,
          },
        ]
      : []),
  ];

  const kpiValues = useMemo(() => {
    const spend = sumBy(filteredRows, "spend");
    const sales = sumBy(filteredRows, "sales");
    const acos = sales > 0 ? (spend / sales) * 100 : 0;

    return {
      impressions: numberText(sumBy(filteredRows, "impressions")),
      spend: `$${spend.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`,
      acos: `${acos.toFixed(2)}%`,
      sales: `$${sales.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`,
      clicks: numberText(sumBy(filteredRows, "clicks")),
    };
  }, [filteredRows]);

  const campaignSummary = useMemo(() => {
    const spend = sumBy(filteredRows, "spend");
    const impressions = sumBy(filteredRows, "impressions");
    const clicks = sumBy(filteredRows, "clicks");
    const orders = sumBy(filteredRows, "orders");
    const sales = sumBy(filteredRows, "sales");
    const dailyBudget = sumBy(filteredRows, "dailyBudget");

    return {
      spend,
      impressions,
      clicks,
      orders,
      sales,
      dailyBudget,
      spendShare: spend > 0 ? 100 : 0,
      impressionShare: impressions > 0 ? 100 : 0,
      clickShare: clicks > 0 ? 100 : 0,
      ctr: impressions > 0 ? (clicks / impressions) * 100 : 0,
      cpc: clicks > 0 ? spend / clicks : 0,
      acos: sales > 0 ? (spend / sales) * 100 : 0,
      roas: spend > 0 ? sales / spend : 0,
    };
  }, [filteredRows]);

  const updateCampaign = (id: string, patch: Partial<AdsCampaign>) => {
    setRows((currentRows) =>
      currentRows.map((row) => (row.id === id ? { ...row, ...patch } : row)),
    );
  };

  const openConfirm = (
    title: string,
    content: ReactNode,
    onOk: () => void,
    danger = false,
  ) => {
    modalApi.confirm({
      title: undefined,
      icon: null,
      content: (
        <ActionModalContent>
          <div className="ads-campaigns-confirm">
            <Typography.Title
              level={5}
              className="ads-campaigns-confirm__title"
            >
              {title}
            </Typography.Title>
            <div className="ads-campaigns-confirm__body">{content}</div>
          </div>
        </ActionModalContent>
      ),
      okText: "确认",
      cancelText: "取消",
      okButtonProps: danger ? { danger: true } : undefined,
      onOk,
    });
  };

  const toggleCampaignStatus = (campaign: AdsCampaign, checked: boolean) => {
    const nextStatus: CampaignStatus = checked ? "enabled" : "paused";
    openConfirm(
      checked ? "启用广告活动" : "暂停广告活动",
      <Typography.Paragraph>
        确认{checked ? "启用" : "暂停"}：{campaign.name}？
      </Typography.Paragraph>,
      () => {
        updateCampaign(campaign.id, { status: nextStatus });
        void messageApi.success("广告活动状态已更新");
      },
      !checked,
    );
  };

  const saveDailyBudget = (campaign: AdsCampaign) => {
    const value = budgetDrafts[campaign.id] ?? campaign.dailyBudget;

    if (value == null || value < 1) {
      void messageApi.warning("每日预算必须大于 0");
      return;
    }

    updateCampaign(campaign.id, { dailyBudget: value });
    setBudgetDrafts((current) => {
      const next = { ...current };
      delete next[campaign.id];
      return next;
    });
    void messageApi.success("每日预算已保存");
  };

  const bulkStatus = () => {
    openConfirm(
      "批量调整状态",
      <Space direction="vertical">
        <Typography.Text>
          已选择 {selectedRowKeys.length} 个广告活动。
        </Typography.Text>
        <Typography.Text type="secondary">
          当前为交互版页面，提交后只更新页面状态。
        </Typography.Text>
      </Space>,
      () => {
        const selected = new Set(selectedRowKeys.map(String));
        setRows((currentRows) =>
          currentRows.map((row) =>
            selected.has(row.id) ? { ...row, status: "paused" } : row,
          ),
        );
        setSelectedRowKeys([]);
        void messageApi.success("批量状态已提交");
      },
      true,
    );
  };

  const bulkBudget = () => {
    openConfirm(
      "批量调整预算",
      <Space direction="vertical">
        <Typography.Text>
          已选择 {selectedRowKeys.length} 个广告活动。
        </Typography.Text>
        <Typography.Text type="secondary">
          示例动作：统一设置每日预算为 $30。
        </Typography.Text>
      </Space>,
      () => {
        const selected = new Set(selectedRowKeys.map(String));
        setRows((currentRows) =>
          currentRows.map((row) =>
            selected.has(row.id) ? { ...row, dailyBudget: 30 } : row,
