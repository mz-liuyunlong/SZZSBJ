      {modalContextHolder}
      <div className="ads-campaigns-delivery">
        <section className="ads-campaigns-kpi-grid" aria-label="广告活动指标">
          <KpiCard
            label="曝光量"
            value={kpiValues.impressions}
            active={activeKpi === "impressions"}
            onClick={() => setActiveKpi("impressions")}
          />
          <KpiCard
            label="广告花费"
            value={kpiValues.spend}
            tone="green"
            active={activeKpi === "spend"}
            onClick={() => setActiveKpi("spend")}
          />
          <KpiCard
            label="ACOS"
            value={kpiValues.acos}
            tone="orange"
            active={activeKpi === "acos"}
            onClick={() => setActiveKpi("acos")}
          />
          <KpiCard
            label="广告销售额"
            value={kpiValues.sales}
            active={activeKpi === "sales"}
            onClick={() => setActiveKpi("sales")}
          />
          <KpiCard
            label="点击"
            value={kpiValues.clicks}
            tone="purple"
            active={activeKpi === "clicks"}
            onClick={() => setActiveKpi("clicks")}
          />
        </section>

        <Card className="ads-campaigns-toolbar" size="small">
          <Space wrap>
            <Dropdown
              trigger={["click"]}
              menu={{
                items: [
                  { key: "SP", label: "创建 SP 广告活动" },
                  { key: "SB", label: "创建 SB 广告活动" },
                  { key: "SV", label: "创建 SV 广告活动" },
                ],
                onClick: (info) =>
                  openCampaignCreateModal(info.key as CampaignCreateType),
              }}
            >
              <Button type="primary" icon={<PlusOutlined />}>
                创建广告活动
              </Button>
            </Dropdown>
            <ReportFacetSelect
              mode="multiple"
              ariaLabel="广告账号"
              placeholder="广告账号"
              unit="个账号"
              value={filters.accounts ?? []}
              options={accountOptions}
              triggerWidth={172}
              onChange={(value) =>
                setFilters((current) => ({
                  ...current,
                  accounts: Array.isArray(value) ? (value as string[]) : [],
                }))
              }
            />
            <Radio.Group
              key={`date-preset-${filters.datePreset}`}
              className="ads-campaigns-date-presets"
              aria-label="日期快捷项"
              optionType="button"
              buttonStyle="solid"
              value={shortcutDatePresetValue(filters.datePreset)}
              options={[
                { label: "今日", value: "today" },
                { label: "本周", value: "week" },
                { label: "本月", value: "month" },
                { label: "今年", value: "year" },
              ]}
              onChange={(event) => {
                const datePreset = event.target.value as Exclude<
                  CampaignDatePreset,
                  "custom"
                >;
                setFilters((current) => ({
                  ...current,
                  datePreset,
                  dateRange: shortcutDateRange(datePreset),
                }));
              }}
            />
            <DatePicker.RangePicker
              className="ads-campaigns-date-range"
              aria-label="日期范围"
              locale={datePickerLocale}
              value={
                filters.dateRange
                  ? [dayjs(filters.dateRange[0]), dayjs(filters.dateRange[1])]
                  : undefined
              }
              presets={rangePresets()}
              format="YYYY-MM-DD"
              disabledDate={disableFutureDate}
              separator="~"
              onChange={(dates) => {
                setFilters((current) => ({
                  ...current,
                  datePreset: "custom",
                  dateRange: dates
                    ? [
                        dates[0]?.format("YYYY-MM-DD") ?? "",
                        dates[1]?.format("YYYY-MM-DD") ?? "",
                      ]
                    : undefined,
                }));
              }}
            />
            <ReportFacetSelect
              mode="multiple"
              ariaLabel="广告类型"
              placeholder="广告类型"
              value={filters.adTypes ?? []}
              options={adTypeOptions}
              unit="类"
              triggerWidth={126}
              onChange={(value) =>
                setFilters((current) => ({
                  ...current,
                  adTypes: Array.isArray(value)
                    ? (value as CampaignType[])
                    : [],
                }))
              }
            />
            <ReportFacetSelect
              mode="multiple"
              ariaLabel="广告活动状态"
              placeholder="广告活动状态"
              unit="个状态"
              value={filters.statuses ?? []}
              options={statusOptions}
              triggerWidth={140}
              onChange={(value) =>
                setFilters((current) => ({
                  ...current,
                  statuses: Array.isArray(value)
                    ? (value as CampaignStatus[])
                    : [],
                }))
              }
            />
            <CommittedSearch
              className="ads-campaigns-search"
              typeAriaLabel="广告活动搜索类型"
              typeOptions={searchOptions}
              typeValue={filters.searchField}
              inputAriaLabel="广告活动搜索"
              inputPlaceholder="请输入广告活动名称"
              inputValue={filters.keyword}
              batch={{
                ariaLabel: "广告活动批量搜索",
                placeholder: "一行一个广告活动名称或ID",
                onCommit: (values, searchField) => {
                  setFilters((current) => ({
                    ...current,
                    searchField: searchField as CampaignFilters["searchField"],
                    keyword: values[0] ?? "",
                  }));
                  void messageApi.info(
                    `已读取 ${values.length} 行批量搜索内容`,
                  );
                },
                onMessage: (content) => void messageApi.warning(content),
              }}
              onCommit={({ searchField, keyword }) =>
                setFilters((current) => ({
                  ...current,
                  searchField: searchField as CampaignFilters["searchField"],
                  keyword,
                }))
              }
            />
            <Button
              icon={<ReloadOutlined />}
              onClick={() => {
                setFilters(initialFilters);
                setSelectedRowKeys([]);
                void messageApi.success("筛选条件已重置");
              }}
            >
              重置
            </Button>
          </Space>
        </Card>

        <ReportTableShell
          label="广告活动表格"
          className="ads-campaigns-table-shell"
        >
          <div className="ads-campaigns-table-head">
            <div>
              <Typography.Text strong>广告活动</Typography.Text>
              <Typography.Text type="secondary">
                {" "}
                已选 {selectedRowKeys.length} 条数据
              </Typography.Text>
            </div>
            <Space wrap>
              <Button
                disabled={selectedRowKeys.length === 0}
                onClick={bulkStatus}
              >
                批量调整状态
              </Button>
              <Button
                disabled={selectedRowKeys.length === 0}
                onClick={bulkBudget}
              >
                批量调整预算
              </Button>
            </Space>
          </div>
          <ProTable<AdsCampaign>
            rowKey="id"
            size="small"
            search={false}
            options={false}
            columns={campaignColumns}
            dataSource={filteredRows}
            tableAlertRender={false}
            toolBarRender={false}
            bordered
            tableLayout="fixed"
            pagination={{
              pageSize: 25,
              showSizeChanger: true,
              showQuickJumper: true,
              showTotal: (total) => `共 ${total} 条数据`,
            }}
            scroll={{ x: campaignScrollX, y: "100%" }}
            footer={() => (
              <ReportTableSelectionBar
                selectedCount={selectedRowKeys.length}
                actions={[
                  {
                    key: "status",
                    label: "批量调整状态",
                    danger: true,
                    onClick: bulkStatus,
                  },
                  { key: "budget", label: "批量调整预算", onClick: bulkBudget },
                ]}
              />
            )}
            summary={() => (
              <Table.Summary fixed>
                <Table.Summary.Row>
                  <Table.Summary.Cell index={0}>
                    <span className="report-table-summary-label">汇总</span>
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={1}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={2}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={3}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={4}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={5}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={6}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={7}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={8}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={9}>--</Table.Summary.Cell>
                  <Table.Summary.Cell index={10}>
                    <MoneyCell value={campaignSummary.spend} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={11}>
                    <PercentCell value={campaignSummary.spendShare} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={12}>
                    <span className="report-table-metric">
                      {campaignSummary.dailyBudget.toLocaleString("en-US")}
                    </span>
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={13}>
                    <span className="report-table-metric">
                      {numberText(campaignSummary.impressions)}
                    </span>
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={14}>
                    <PercentCell value={campaignSummary.impressionShare} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={15}>
                    <span className="report-table-metric">
                      {numberText(campaignSummary.clicks)}
                    </span>
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={16}>
                    <PercentCell value={campaignSummary.clickShare} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={17}>
                    <PercentCell value={campaignSummary.ctr} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={18}>
                    <MoneyCell value={campaignSummary.cpc} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={19}>
                    <span className="report-table-metric">
                      {numberText(campaignSummary.orders)}
                    </span>
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={20}>
                    <MoneyCell value={campaignSummary.sales} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={21}>
                    <PercentCell value={campaignSummary.acos} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={22}>
                    <RoiCell value={campaignSummary.roas} />
                  </Table.Summary.Cell>
                  <Table.Summary.Cell index={23}>--</Table.Summary.Cell>
                </Table.Summary.Row>
              </Table.Summary>
            )}
          />
        </ReportTableShell>

        <div className="ads-campaigns-footer-hint">
          <CalendarOutlined aria-hidden="true" />
          <span>
            当前为广告活动页面前端交互版；后续接 Walmart Connect API
            时沿用此页面结构。
          </span>
        </div>
      </div>
    </>
  );
}

export default DeliveryManagementTab;
