const rangePresets = (): { label: string; value: [Dayjs, Dayjs] }[] => {
  const today = dayjs();
  return [
    { label: "今天", value: [today, today] },
    {
      label: "昨天",
      value: [today.subtract(1, "day"), today.subtract(1, "day")],
    },
    { label: "最近7天", value: [today.subtract(6, "day"), today] },
    { label: "最近30天", value: [today.subtract(29, "day"), today] },
    { label: "本月", value: [today.startOf("month"), today] },
    {
      label: "上月",
      value: [
        today.subtract(1, "month").startOf("month"),
        today.subtract(1, "month").endOf("month"),
      ],
    },
    { label: "本年", value: [today.startOf("year"), today] },
    {
      label: "去年",
      value: [
        today.subtract(1, "year").startOf("year"),
        today.subtract(1, "year").endOf("year"),
      ],
    },
  ];
};

const formatDate = (value: Dayjs) => value.format("YYYY-MM-DD");

const actualTodayRange = (): [string, string] => {
  const today = formatDate(dayjs());
  return [today, today];
};

const shortcutDateRange = (
  datePreset: Exclude<CampaignDatePreset, "custom">,
): [string, string] => {
  const today = dayjs();

  if (datePreset === "today") return actualTodayRange();
  if (datePreset === "week")
    return [formatDate(today.startOf("week")), formatDate(today)];
  if (datePreset === "month")
    return [formatDate(today.startOf("month")), formatDate(today)];
  return [formatDate(today.startOf("year")), formatDate(today)];
};

const shortcutDatePresetValue = (datePreset?: CampaignDatePreset) =>
  datePreset === "custom" ? undefined : datePreset;

