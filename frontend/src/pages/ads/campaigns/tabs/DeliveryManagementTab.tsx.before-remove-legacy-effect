const resolveTableScrollX = <RowType,>(
  columns: ProColumns<RowType>[],
  minWidth: number,
) =>
  Math.max(
    minWidth,
    columns.reduce((total, column) => {
      const width = column.width;
      if (typeof width === "number") return total + width;
      if (typeof width === "string") {
        const parsedWidth = Number.parseInt(width, 10);
        return total + (Number.isFinite(parsedWidth) ? parsedWidth : 112);
      }
      return total + 112;
    }, 56),
  );

function sumBy(rows: readonly AdsCampaign[], key: keyof AdsCampaign) {
  return rows.reduce((total, row) => {
    const value = row[key];
    return total + (typeof value === "number" ? value : 0);
  }, 0);
}

