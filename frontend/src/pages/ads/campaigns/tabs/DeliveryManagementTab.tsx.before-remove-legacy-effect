        void messageApi.success("批量预算已提交");
      },
    );
  };

  const openDetail = (campaign: AdsCampaign) => {
    setActiveCampaignId(campaign.id);
    setDetailTab("adGroups");
    setDetailSelectedRowKeys([]);
    setView("detail");
  };

  const submitCreate = async () => {
    const values = await createForm.validateFields();
    const campaign: AdsCampaign = {
      id: `YC${Math.floor(Math.random() * 90000 + 10000)}`,
      account: "Saiyu Artcave TECHN...",
      name: values.name,
      type: values.type,
      target: values.target,
      status: "enabled",
      startDate: values.startDate,
      endDate: values.endDate || "--",
      budgetType: "每日预算",
      totalBudget: "--",
      dailyBudget: values.dailyBudget,
      spend: 0,
      spendShare: 0,
      impressions: 0,
      impressionShare: 0,
      clicks: 0,
      clickShare: 0,
      ctr: 0,
      cpc: Number(values.defaultBid),
      orders: 0,
      sales: 0,
      acos: 0,
      roas: 0,
    };

    setRows((currentRows) => [campaign, ...currentRows]);
    setActiveCampaignId(campaign.id);
    setDetailTab("adGroups");
    setView("detail");
    void messageApi.success("广告活动已创建");
  };

  const selectedCampaignIdSet = new Set(selectedRowKeys.map(String));
  const filteredCampaignIds = filteredRows.map((row) => row.id);
  const isAllFilteredCampaignSelected =
    filteredRows.length > 0 &&
    filteredCampaignIds.every((id) => selectedCampaignIdSet.has(id));
  const isPartlyFilteredCampaignSelected =
    filteredCampaignIds.some((id) => selectedCampaignIdSet.has(id)) &&
    !isAllFilteredCampaignSelected;

  const toggleCampaignSelection = (id: string, checked: boolean) => {
    setSelectedRowKeys((current) => {
      const currentIds = new Set(current.map(String));
      if (checked) currentIds.add(id);
      else currentIds.delete(id);
      return Array.from(currentIds);
    });
  };

  const toggleAllFilteredCampaignSelection = (checked: boolean) => {
    const visibleIds = new Set(filteredCampaignIds);
    setSelectedRowKeys((current) => {
      const currentIds = new Set(current.map(String));
      if (checked) {
        visibleIds.forEach((id) => currentIds.add(id));
      } else {
        visibleIds.forEach((id) => currentIds.delete(id));
      }
      return Array.from(currentIds);
    });
  };

  const currentDetailRows = campaignDetailRows[detailTab];
  const selectedDetailIdSet = new Set(detailSelectedRowKeys.map(String));
  const currentDetailIds = currentDetailRows.map((row) => row.id);
