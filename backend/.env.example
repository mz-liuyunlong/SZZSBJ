APP_ENV=local
DATABASE_URL=<injected-postgresql-url>
TEST_DATABASE_URL=<injected-isolated-test-postgresql-url>
WALMART_MONITOR_INGEST_TOKEN=
WALMART_MONITOR_TARGETS_TOKEN=
LINGXING_BASE_URL=<injected-https-origin>
LINGXING_APP_ID=<injected-app-id>
LINGXING_APP_SECRET=<injected-secret-ref>
LINGXING_ACCESS_TOKEN=<injected-secret-ref>
LINGXING_ENABLE_TOKEN_REQUESTS=false
LINGXING_TOKEN_REFRESH_SAFETY_SECONDS=600
LINGXING_TOKEN_REFRESH_SHORT_TTL_RATIO=0.2
LINGXING_TOKEN_REQUEST_TIMEOUT_MS=10000
LINGXING_TOKEN_MAX_ATTEMPTS=2
LINGXING_TIMEOUT_MS=5000
LINGXING_SAMPLE_PAGE_SIZE=3
LINGXING_MAX_SAMPLE_PAGES=1
LINGXING_MAX_RESPONSE_BYTES=1048576
LINGXING_ENABLE_REAL_CALLS=false
WFS_AUTO_DETECT_ENABLED=false
WFS_AUTO_CASE_CREATE_ENABLED=false
WFS_SETTLEMENT_SCOPE_VERIFIED=false
WFS_DETECT_LOOKBACK_DAYS=60
WFS_DETECT_SETTLEMENT_LAG_DAYS=2
WFS_DETECT_MIN_SAMPLE_UNITS=10
WFS_DETECT_MAX_STALE_DAYS=14
LINGXING_SAVE_RAW=true
LINGXING_DRY_RUN=true
LINGXING_ALLOW_RAW_WRITE=false
LINGXING_ALLOW_STRUCTURED_WRITE=false
LINGXING_ALLOW_FULL_SYNC=false

# Media cache remains disabled until storage, signing, and source-host allowlist are configured.
MEDIA_CACHE_ENABLED=false
MEDIA_STORAGE_ROOT=<injected-absolute-media-storage-path>
MEDIA_SIGNING_SECRET=<injected-secret-ref-at-least-32-chars>
MEDIA_ALLOWED_SOURCE_HOSTS=<comma-separated-approved-image-hostnames>
MEDIA_DOWNLOAD_TIMEOUT_MS=8000
MEDIA_MAX_SOURCE_BYTES=10485760
MEDIA_MAX_SOURCE_PIXELS=40000000
MEDIA_SIGNED_URL_TTL_SECONDS=3600
MEDIA_PROCESSING_STALE_SECONDS=900
MEDIA_MAX_ATTEMPTS=3

# Finance cashflow statement upload. Originals go under MEDIA_STORAGE_ROOT/finance/cashflow.
# 四类审批定义编码，真实值不进仓库：费用报销=…,付款申请=…,备用金申请=…,备用金核销=…
FINANCE_APPROVAL_CODES=
# 逗号分隔的飞书部门 ID：这些部门的审批单不进日记账的报销闭环。
FINANCE_APPROVAL_EXCLUDED_DEPARTMENT_IDS=
# 第二个飞书企业的审批单（单号前加 YC-）；不配 YC_FINANCE_APPROVAL_CODES 就不拉。
YC_FEISHU_APP_ID=
YC_FEISHU_APP_SECRET=
YC_FEISHU_BASE_URL=https://open.feishu.cn
YC_FINANCE_APPROVAL_CODES=
# 逗号分隔：日记账账户「主体」里属于这家公司的；不配则这家公司的审批单只能手动挂单。
YC_FINANCE_ENTITIES=
YC_FINANCE_ORG_LABEL=YC
# 主公司在页面上显示的名字
FINANCE_APPROVAL_ORG_LABEL=主公司
FINANCE_CASHFLOW_MAX_UPLOAD_BYTES=20971520

# Celery worker configuration
# Production workers must set CELERY_BROKER_URL and keep
# SZZSBJ_CELERY_REQUIRE_BROKER=true before starting any worker process.
CELERY_BROKER_URL=
SZZSBJ_CELERY_REQUIRE_BROKER=false

# Business connector encryption: provide exactly one source in trusted deployment environment.
# Never generate a new key if encrypted credentials already exist.
BUSINESS_CONFIG_ENCRYPTION_KEY=
BUSINESS_CONFIG_ENCRYPTION_KEY_FILE=
