APP_ENV=local
DATABASE_URL=<injected-postgresql-url>
TEST_DATABASE_URL=<injected-isolated-test-postgresql-url>
LINGXING_BASE_URL=<injected-https-origin>
LINGXING_APP_ID=<injected-app-id>
LINGXING_APP_SECRET=<injected-secret-ref>
LINGXING_ACCESS_TOKEN=<injected-secret-ref>
LINGXING_TIMEOUT_MS=5000
LINGXING_SAMPLE_PAGE_SIZE=3
LINGXING_MAX_SAMPLE_PAGES=1
LINGXING_MAX_RESPONSE_BYTES=1048576
LINGXING_ENABLE_REAL_CALLS=false
LINGXING_SAVE_RAW=true
LINGXING_DRY_RUN=true
LINGXING_ALLOW_RAW_WRITE=false
LINGXING_ALLOW_STRUCTURED_WRITE=false
LINGXING_ALLOW_FULL_SYNC=false
